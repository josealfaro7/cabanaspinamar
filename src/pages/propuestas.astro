---
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Presentación de Propuestas — Cabañas Pinamar</title>
    <link rel="icon" type="image/png" href="./logocabanas.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A2246] text-white font-['Plus_Jakarta_Sans',sans-serif] h-screen w-screen overflow-hidden flex flex-col m-0 p-0">
    <!-- Barra Superior de Control / Slider de Temas para el Cliente -->
    <header class="bg-[#0A2246] border-b border-white/15 px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-4 shrink-0 z-50 shadow-xl">
      <div class="flex items-center gap-3">
        <img id="brand-logo" src="/logocabanas.png" alt="Cabañas Pinamar" class="h-9 w-9 rounded-full bg-white p-0.5" />
        <div>
          <span class="block text-[10px] uppercase tracking-widest text-[#F9C600] font-bold">
            MODO PRESENTACIÓN CLIENTES · 5 PROPUESTAS
          </span>
          <h1 id="theme-title" class="text-sm sm:text-base font-bold text-white leading-tight">
            Tema 1: Hotel Boutique Clásico (Rama main)
          </h1>
        </div>
      </div>

      <!-- Slider + Botones de Propuestas -->
      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5">
          <button
            type="button"
            id="prev-theme"
            class="w-7 h-7 border border-white/30 hover:border-white flex items-center justify-center font-bold text-sm cursor-pointer"
            aria-label="Tema anterior"
          >
            ‹
          </button>
          <input
            type="range"
            id="theme-slider"
            min="0"
            max="4"
            step="1"
            value="0"
            class="w-28 sm:w-36 accent-[#F9C600] cursor-pointer"
            aria-label="Deslizar entre los 5 temas"
          />
          <button
            type="button"
            id="next-theme"
            class="w-7 h-7 border border-white/30 hover:border-white flex items-center justify-center font-bold text-sm cursor-pointer"
            aria-label="Tema siguiente"
          >
            ›
          </button>
        </div>

        <div class="hidden xl:flex items-center gap-1.5" id="theme-pills">
          <button
            type="button"
            data-index="0"
            class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-[#F9C600] bg-[#F9C600] text-[#0A2246] transition-all cursor-pointer"
          >
            1. Clásico
          </button>
          <button
            type="button"
            data-index="1"
            class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-white/25 text-white/80 hover:border-white transition-all cursor-pointer"
          >
            2. Editorial (Lora)
          </button>
          <button
            type="button"
            data-index="2"
            class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-white/25 text-white/80 hover:border-white transition-all cursor-pointer"
          >
            3. Retro-Sunset
          </button>
          <button
            type="button"
            data-index="3"
            class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-white/25 text-white/80 hover:border-white transition-all cursor-pointer"
          >
            4. Gradiente Continuo
          </button>
          <button
            type="button"
            data-index="4"
            class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-white/25 text-white/80 hover:border-white transition-all cursor-pointer"
          >
            5. Costero Orgánico (Bento)
          </button>
        </div>

        <a
          id="open-direct-link"
          href="http://localhost:4321/"
          target="_blank"
          class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider bg-[#E63B06] hover:bg-[#F06A00] text-white transition-all"
        >
          Abrir en pestaña ↗
        </a>
      </div>
    </header>

    <!-- Contenedor de Iframes de las 5 Ramas (Carga Instantánea) -->
    <main class="flex-1 relative w-full h-full bg-white">
      <iframe
        id="frame-0"
        src="about:blank"
        title="Rama main"
        class="w-full h-full border-0 absolute inset-0 opacity-100 z-10 transition-opacity duration-300"
      ></iframe>
      <iframe
        id="frame-1"
        src="about:blank"
        title="Rama feat/frontend-design"
        class="w-full h-full border-0 absolute inset-0 opacity-0 pointer-events-none z-0 transition-opacity duration-300"
      ></iframe>
      <iframe
        id="frame-2"
        src="about:blank"
        title="Rama feat/ui-retro-sunset"
        class="w-full h-full border-0 absolute inset-0 opacity-0 pointer-events-none z-0 transition-opacity duration-300"
      ></iframe>
      <iframe
        id="frame-3"
        src="about:blank"
        title="Rama background-gradiente"
        class="w-full h-full border-0 absolute inset-0 opacity-0 pointer-events-none z-0 transition-opacity duration-300"
      ></iframe>
      <iframe
        id="frame-4"
        src="about:blank"
        title="Rama feat/coastal-organic"
        class="w-full h-full border-0 absolute inset-0 opacity-0 pointer-events-none z-0 transition-opacity duration-300"
      ></iframe>
    </main>

    <script>
      const isLocal =
        window.location.hostname === 'localhost' ||
        window.location.hostname === '127.0.0.1';

      // Base en GitHub Pages (/cabanaspinamar) vs entorno local
      const ghBase = window.location.pathname.startsWith('/cabanaspinamar')
        ? '/cabanaspinamar'
        : '';

      const brandLogo = document.getElementById('brand-logo') as HTMLImageElement | null;
      if (brandLogo && !isLocal) {
        brandLogo.src = `${ghBase}/logocabanas.png`;
      }

      const themes = [
        {
          title: 'Tema 1: Hotel Boutique Clásico (Rama main)',
          url: isLocal ? 'http://localhost:4321/' : `${ghBase}/p1/`,
        },
        {
          title: 'Tema 2: Editorial Minimalista en Lora (Rama feat/frontend-design)',
          url: isLocal ? 'http://localhost:4322/' : `${ghBase}/p2/`,
        },
        {
          title: 'Tema 3: Retro-Sunset del Logo (Rama feat/ui-retro-sunset)',
          url: isLocal ? 'http://localhost:4323/' : `${ghBase}/p3/`,
        },
        {
          title: 'Tema 4: Atardecer Continuo Difuminado (Rama background-gradiente)',
          url: isLocal ? 'http://localhost:4324/' : `${ghBase}/p4/`,
        },
        {
          title: 'Tema 5: Costero Orgánico & Bento Resort (Rama feat/coastal-organic)',
          url: isLocal ? 'http://localhost:4325/' : `${ghBase}/p5/`,
        },
      ];

      // Inicializar src de los 5 iframes según el entorno (Localhost o GitHub Pages)
      themes.forEach((t, i) => {
        const frame = document.getElementById(`frame-${i}`) as HTMLIFrameElement | null;
        if (frame) frame.src = t.url;
      });

      let currentIdx = 0;
      const slider = document.getElementById('theme-slider') as HTMLInputElement | null;
      const titleEl = document.getElementById('theme-title');
      const directLink = document.getElementById('open-direct-link') as HTMLAnchorElement | null;
      const prevBtn = document.getElementById('prev-theme');
      const nextBtn = document.getElementById('next-theme');
      const pills = document.querySelectorAll<HTMLButtonElement>('#theme-pills button');

      if (directLink) directLink.href = themes[0].url;

      function setTheme(idx: number) {
        currentIdx = (idx + themes.length) % themes.length;
        if (slider) slider.value = String(currentIdx);
        if (titleEl) titleEl.textContent = themes[currentIdx].title;
        if (directLink) directLink.href = themes[currentIdx].url;

        themes.forEach((_, i) => {
          const frame = document.getElementById(`frame-${i}`);
          if (!frame) return;
          if (i === currentIdx) {
            frame.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
            frame.classList.add('opacity-100', 'z-10');
          } else {
            frame.classList.remove('opacity-100', 'z-10');
            frame.classList.add('opacity-0', 'pointer-events-none', 'z-0');
          }
        });

        pills.forEach((pill, i) => {
          if (i === currentIdx) {
            pill.className =
              'px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-[#F9C600] bg-[#F9C600] text-[#0A2246] transition-all cursor-pointer';
          } else {
            pill.className =
              'px-3 py-1.5 text-xs font-bold uppercase tracking-wider border border-white/25 text-white/80 hover:border-white transition-all cursor-pointer';
          }
        });
      }

      slider?.addEventListener('input', (e) => {
        const val = Number((e.target as HTMLInputElement).value);
        setTheme(val);
      });

      prevBtn?.addEventListener('click', () => setTheme(currentIdx - 1));
      nextBtn?.addEventListener('click', () => setTheme(currentIdx + 1));

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const idx = Number(pill.getAttribute('data-index') || 0);
          setTheme(idx);
        });
      });
    </script>
  </body>
</html>
