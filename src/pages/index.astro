---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustServices from '../components/TrustServices.astro';
import CabinCatalog from '../components/CabinCatalog.astro';
import HowToBook from '../components/HowToBook.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const HOTELSYNC_BOOKING_URL =
  'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0';
---

<Layout>
  <!-- Sección 0: Header / Navbar (Sticky) -->
  <Navbar />

  <!-- Fondo atmosférico cálido directamente en <main> (token bg-atmosphere); sin capas ni isolate, para que el modal quede sobre la navbar -->
  <main class="flex-1 relative overflow-hidden bg-cream bg-atmosphere">
    <!-- Sección 1: Hero Section (100% Transparente con Caja Central Blanca Nítida) -->
    <Hero hotelSyncUrl={HOTELSYNC_BOOKING_URL} />

    <!-- Sección 2: Confianza y Servicios Rápidos (100% Transparente) -->
    <TrustServices />

    <!-- Sección 3: Catálogo de Cabañas (100% Transparente) -->
    <CabinCatalog />

    <!-- Sección: Cómo Reservar (100% Transparente) -->
    <HowToBook hotelSyncUrl={HOTELSYNC_BOOKING_URL} />

    <!-- Sección: Reseñas de Google (Debajo de Cómo Reservar) -->
    <GoogleReviews />

    <!-- Sección 4: Ubicación Privilegiada (100% Transparente) -->
    <Location />
  </main>

  <!-- Sección 5: Footer y Políticas -->
  <Footer />

  <!-- Botón Flotante Permanente de WhatsApp -->
  <WhatsAppFloat />
</Layout>
