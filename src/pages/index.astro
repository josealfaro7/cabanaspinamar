---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Intro from '../components/Intro.astro';
import NuestrasCabanas from '../components/NuestrasCabanas.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SeoSchema from '../components/SeoSchema.astro';
import { asset } from '../data/site';
---

<Layout>
  <SeoSchema slot="head" />
  <link slot="head" rel="preload" as="image" href={asset('/video/terraza-poster.jpg')} fetchpriority="high" />
  <Header />
  <main id="contenido">
    <HeroVideo />
    <Intro />
    <NuestrasCabanas />
    <Services />
    <Reviews />
    <Location />
  </main>
  <Footer />
  <MobileBar />
  <WhatsAppFloat />
</Layout>
