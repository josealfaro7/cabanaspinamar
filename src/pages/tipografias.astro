---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Intro from '../components/Intro.astro';
import NuestrasCabanas from '../components/NuestrasCabanas.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import FontSwitcher from '../components/FontSwitcher.astro';
---

<Layout title="Tipografías · Cabañas Pinamar">
  <Header />
  <main id="contenido">
    <HeroVideo />
    <Intro />
    <NuestrasCabanas />
    <Services />
    <Reviews />
    <Location />
  </main>
  <Footer />
  <MobileBar />
  <WhatsAppFloat />
  <FontSwitcher />
</Layout>
