---
// Herramienta de desarrollo: solo se monta con `npm run dev` (ver Cabins.astro).
// Compara tratamientos de las fotos de las cabañas en vivo.
---

<div
  id="photo-tuner"
  class="fixed left-3 bottom-24 sm:bottom-4 z-[90] w-72 bg-ink text-bone text-sm shadow-2xl p-4 font-sans"
  role="group"
  aria-label="Comparar estilos de fotos de cabañas (solo desarrollo)"
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-[11px] uppercase tracking-[0.08em] text-bone/70">Fotos cabañas · dev</span>
    <button type="button" id="pt-hide" class="text-bone/70 hover:text-bone px-1" aria-label="Ocultar panel">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <label for="pt-style" class="mt-3 flex items-baseline justify-between">
    <span>Opción <output id="pt-style-n" class="tabular-nums">1</output></span>
    <output id="pt-style-name" class="font-display text-lg">Rectas</output>
  </label>
  <input id="pt-style" type="range" min="1" max="5" step="1" value="1" class="mt-2 w-full accent-terracotta" />
  <p id="pt-style-desc" class="mt-1 text-[12px] text-bone/70 min-h-[2.5em]"></p>

  <label for="pt-radius" class="mt-3 flex items-baseline justify-between">
    <span>Redondeo</span>
    <output id="pt-radius-v" class="tabular-nums">16 px</output>
  </label>
  <input id="pt-radius" type="range" min="0" max="40" step="2" value="16" class="mt-2 w-full accent-terracotta" />

  <div class="mt-3 flex gap-2">
    <button type="button" id="pt-goto" class="flex-1 h-9 border border-bone/25 hover:border-bone">Ir a cabañas</button>
    <button type="button" id="pt-copy" class="flex-1 h-9 bg-terracotta hover:bg-terracotta-dark">Copiar elección</button>
  </div>
</div>

<script is:inline>
  (() => {
    const panel = document.getElementById('photo-tuner');
    const section = document.getElementById('cabanas');
    if (!panel || !section) return;
    const KEY = 'pinamar-photo-style';
    const styles = [
      { id: 'square', name: 'Rectas', desc: 'Lo actual: esquinas rectas, sin marco ni sombra.', radius: false },
      { id: 'rounded', name: 'Redondeadas', desc: 'Esquinas suaves. Lo más cercano a Tierra/Explora.', radius: true },
      { id: 'arch', name: 'Arco', desc: 'Parte superior en arco, eco de arquitectura mediterránea.', radius: true },
      { id: 'frame', name: 'Marco blanco', desc: 'Borde blanco tipo foto impresa, con sombra leve.', radius: true },
      { id: 'lifted', name: 'Flotante', desc: 'Redondeadas con sombra difusa, separadas del fondo.', radius: true },
    ];
    const $ = (id) => document.getElementById(id);
    const styleIn = $('pt-style');
    const radiusIn = $('pt-radius');

    const apply = (n, r) => {
      const st = styles[n - 1];
      section.dataset.photoStyle = st.id;
      section.style.setProperty('--photo-radius', `${r}px`);
      styleIn.value = n;
      radiusIn.value = r;
      radiusIn.disabled = !st.radius;
      radiusIn.style.opacity = st.radius ? '1' : '0.35';
      $('pt-style-n').textContent = n;
      $('pt-style-name').textContent = st.name;
      $('pt-style-desc').textContent = st.desc;
      $('pt-radius-v').textContent = `${r} px`;
      try { localStorage.setItem(KEY, JSON.stringify({ n, r })); } catch {}
    };

    let saved = null;
    try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
    apply(saved?.n ?? 1, saved?.r ?? 16);

    styleIn.addEventListener('input', () => apply(+styleIn.value, +radiusIn.value));
    radiusIn.addEventListener('input', () => apply(+styleIn.value, +radiusIn.value));
    $('pt-goto').addEventListener('click', () => section.scrollIntoView({ behavior: 'smooth' }));
    $('pt-copy').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const st = styles[+styleIn.value - 1];
      const text = `Fotos: ${st.name} (${st.id}), redondeo ${radiusIn.value}px`;
      try { await navigator.clipboard.writeText(text); btn.textContent = 'Copiado'; } catch { btn.textContent = st.name; }
      setTimeout(() => (btn.textContent = 'Copiar elección'), 1500);
    });
    $('pt-hide').addEventListener('click', () => panel.remove());
  })();
</script>
