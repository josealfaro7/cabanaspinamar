---

<section id="cabanas" class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 bg-transparent">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado de Sección -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block bg-white text-pinamar-navy text-xs uppercase tracking-widest font-bold px-3.5 py-1 mb-3 border border-amber-900/10 shadow-sm">
        TU REFUGIO EN LA SERENA
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy tracking-tight leading-snug mb-4">
        Catálogo de <span class="italic font-normal text-sunset-5">Cabañas</span>
      </h2>
      <!-- Línea Decorativa con el Degradado Vivo del Logo al 100% de Saturación -->
      <div class="w-24 h-1 mx-auto bg-logo-vivid-line bg-gradient-to-r from-[#f9c116] to-[#e76a14] mb-5"></div>
      <p class="text-pinamar-navy/80 leading-relaxed text-base">
        Espacios luminosos y completamente equipados para parejas, familias y grupos de hasta 7 personas.
      </p>
    </div>

    <!-- Isla Interactiva Vue 3 (Tarjetas Blanco Puro Sólido) -->
    <CabinCatalogIsland client:visible cabins={cabins} />
  </div>
</section>
