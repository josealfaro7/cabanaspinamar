---
import HowToBookIsland from './HowToBookIsland.vue';

interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section id="como-reservar" class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block rounded-full bg-white text-[#E86F2C] text-xs uppercase tracking-widest font-bold px-4 py-1.5 mb-3 border border-[#0A2246]/10 shadow-sm">
        GUÍA PASO A PASO
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#0A2246] tracking-tight leading-snug mb-3">
        ¿Cómo <span class="italic font-normal text-[#E86F2C]">Reservar</span> tu Estadía?
      </h2>
      <p class="text-[#0A2246]/75 leading-relaxed text-base">
        Selecciona el canal de tu preferencia para desplegar el paso a paso de tu reserva.
      </p>
    </div>

    <HowToBookIsland client:visible hotelSyncUrl={hotelSyncUrl} />
  </div>
</section>
