---
interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;

const hotelSyncSteps = [
  {
    step: '01',
    title: 'Entras al link',
    description: 'Accede a nuestro motor oficial de reservas en línea.',
  },
  {
    step: '02',
    title: 'Eliges fecha de llegada y salida',
    description: 'Selecciona los días exactos de tu estadía en el calendario.',
  },
  {
    step: '03',
    title: 'Eliges cabaña',
    description: 'Revisa las tipologías disponibles y sus tarifas en tiempo real.',
  },
  {
    step: '04',
    title: 'Confirmas cabaña',
    description: 'Selecciona la unidad que mejor se adapte a tu grupo familiar.',
  },
  {
    step: '05',
    title: 'Rellenas formulario',
    description: 'Ingresa los datos del titular de la reserva de forma rápida.',
  },
  {
    step: '06',
    title: 'Confirmas reserva',
    description: 'Utiliza la pasarela de pago integrada y asegura tu estadía al instante.',
  },
];

const whatsappSteps = [
  {
    step: '01',
    title: 'Rellenar formulario',
    description: 'Selecciona la cabaña de tu interés en el catálogo y completa tu nombre, fechas y cantidad de personas.',
  },
  {
    step: '02',
    title: 'Consulta por disponibilidad',
    description: 'Envía el formulario para abrir el chat con recepción y verificar disponibilidad en tus fechas.',
  },
  {
    step: '03',
    title: 'Coordina el pago',
    description: 'Coordina la transferencia o medio de pago directamente con nuestro equipo para confirmar tu estadía.',
  },
];
---

<section id="como-reservar" class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12 bg-background border-t border-gray-200">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado de Sección -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs uppercase tracking-widest text-accent font-bold mb-3">
        GUÍA PASO A PASO
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary mb-4">
        ¿Cómo Reservar tu Estadía?
      </h2>
      <p class="text-sm sm:text-base text-gray-600">
        Selecciona el canal de tu preferencia para desplegar el paso a paso de tu reserva.
      </p>
    </div>

    <!-- Contenedor Grid Responsivo con Ordenamiento Inteligente (Móvil vs Desktop) -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 1. Botón Selector: Reserva por HotelSync (order-1 en móvil y desktop) -->
      <button
        type="button"
        data-booking-toggle="hotelsync"
        aria-expanded="false"
        class="order-1 md:order-1 group w-full text-left bg-surface border border-gray-200 hover:border-primary p-8 rounded-none transition-all duration-300 ease-in-out flex items-center justify-between gap-4 focus:outline-none"
      >
        <div>
          <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-2">
            PASARELA DE PAGO EN LÍNEA
          </span>
          <h3 class="font-serif text-2xl font-bold text-primary">
            Reserva por HotelSync
          </h3>
          <p class="text-xs text-gray-500 mt-2">
            Haz clic para ver los 6 pasos de compra y confirmación inmediata.
          </p>
        </div>
        <span
          data-toggle-icon="hotelsync"
          class="w-10 h-10 border border-gray-200 group-hover:border-primary text-primary flex items-center justify-center shrink-0 transition-transform duration-300 ease-in-out"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>

      <!-- 2. Panel Desplegable: Flujo HotelSync (order-2 en móvil para desplazar WhatsApp hacia abajo, md:order-3 en desktop) -->
      <div
        id="panel-hotelsync"
        class="order-2 md:order-3 md:col-span-2 hidden bg-surface border border-gray-200 p-8 sm:p-12 rounded-none opacity-0 translate-y-4 transition-all duration-300 ease-in-out"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-6 mb-8 border-b border-gray-200">
          <div>
            <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-1">
              PASO A PASO · HOTELSYNC
            </span>
            <h4 class="font-serif text-2xl font-bold text-primary">
              Flujo de Reserva Online con Pasarela de Pago
            </h4>
          </div>
          <span class="inline-block border border-primary/20 text-primary text-xs uppercase tracking-widest font-bold px-3 py-1.5 rounded-none self-start sm:self-center">
            6 Pasos Simples
          </span>
        </div>

        <!-- Tarjetas de los 6 Pasos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-px bg-gray-200 border border-gray-200 mb-8">
          {hotelSyncSteps.map((item) => (
            <div class="bg-surface p-6 flex flex-col justify-between">
              <div>
                <span class="font-serif text-2xl font-bold text-accent block mb-3">
                  {item.step}
                </span>
                <h5 class="font-bold text-primary text-xs uppercase tracking-wider mb-2">
                  {item.title}
                </h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-200">
          <p class="text-xs text-gray-500">
            Disponibilidad en tiempo real y confirmación automática.
          </p>
          <a
            href={hotelSyncUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto text-center bg-primary hover:bg-accent text-white font-bold text-xs uppercase tracking-widest px-8 py-4 rounded-none transition-all duration-300 ease-in-out"
          >
            Ir a HotelSync Ahora
          </a>
        </div>
      </div>

      <!-- 3. Botón Selector: Reserva por WhatsApp (order-3 en móvil, md:order-2 en desktop) -->
      <button
        type="button"
        data-booking-toggle="whatsapp"
        aria-expanded="false"
        class="order-3 md:order-2 group w-full text-left bg-surface border border-gray-200 hover:border-primary p-8 rounded-none transition-all duration-300 ease-in-out flex items-center justify-between gap-4 focus:outline-none"
      >
        <div>
          <span class="block text-xs uppercase tracking-widest text-[#25D366] font-bold mb-2">
            ATENCIÓN ASISTIDA DIRECTA
          </span>
          <h3 class="font-serif text-2xl font-bold text-primary">
            Reserva por WhatsApp
          </h3>
          <p class="text-xs text-gray-500 mt-2">
            Haz clic para ver el flujo rápido de consulta con recepción.
          </p>
        </div>
        <span
          data-toggle-icon="whatsapp"
          class="w-10 h-10 border border-gray-200 group-hover:border-primary text-primary flex items-center justify-center shrink-0 transition-transform duration-300 ease-in-out"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </button>

      <!-- 4. Panel Desplegable: Flujo WhatsApp (order-4 en móvil y desktop) -->
      <div
        id="panel-whatsapp"
        class="order-4 md:order-4 md:col-span-2 hidden bg-surface border border-gray-200 p-8 sm:p-12 rounded-none opacity-0 translate-y-4 transition-all duration-300 ease-in-out"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-6 mb-8 border-b border-gray-200">
          <div>
            <span class="block text-xs uppercase tracking-widest text-[#25D366] font-bold mb-1">
              PASO A PASO · WHATSAPP
            </span>
            <h4 class="font-serif text-2xl font-bold text-primary">
              Flujo Directo de Consulta y Reserva
            </h4>
          </div>
          <span class="inline-block border border-primary/20 text-primary text-xs uppercase tracking-widest font-bold px-3 py-1.5 rounded-none self-start sm:self-center">
            3 Pasos Rápidos
          </span>
        </div>

        <!-- Tarjetas de los 3 Pasos de WhatsApp -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-200 border border-gray-200 mb-8">
          {whatsappSteps.map((item) => (
            <div class="bg-surface p-6 flex flex-col justify-between">
              <div>
                <span class="font-serif text-2xl font-bold text-[#25D366] block mb-3">
                  {item.step}
                </span>
                <h5 class="font-bold text-primary text-xs uppercase tracking-wider mb-2">
                  {item.title}
                </h5>
                <p class="text-xs text-gray-500 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-200">
          <p class="text-xs text-gray-500">
            Atención directa con nuestra recepción las 24 horas.
          </p>
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
            <a
              href="#cabanas"
              class="w-full sm:w-auto text-center border border-primary text-primary hover:bg-primary hover:text-white font-bold text-xs uppercase tracking-widest px-6 py-4 rounded-none transition-all duration-300 ease-in-out"
            >
              Ver Catálogo de Cabañas
            </a>
            <a
              href="https://wa.me/56974635702"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-center bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs uppercase tracking-widest px-6 py-4 rounded-none transition-all duration-300 ease-in-out"
            >
              Consultar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('[data-booking-toggle]');
  const panels: Record<string, HTMLElement | null> = {
    hotelsync: document.getElementById('panel-hotelsync'),
    whatsapp: document.getElementById('panel-whatsapp'),
  };
  const icons: Record<string, HTMLElement | null> = {
    hotelsync: document.querySelector('[data-toggle-icon="hotelsync"]'),
    whatsapp: document.querySelector('[data-toggle-icon="whatsapp"]'),
  };

  let activePanel: string | null = null;

  function setPanelState(targetKey: string) {
    const isClosingCurrent = activePanel === targetKey;

    // Ocultar todos los paneles primero
    Object.keys(panels).forEach((key) => {
      const panel = panels[key];
      const icon = icons[key];
      const btn = document.querySelector(`[data-booking-toggle="${key}"]`);

      if (panel) {
        panel.classList.add('opacity-0', 'translate-y-4');
        panel.classList.remove('opacity-100', 'translate-y-0');
        panel.classList.add('hidden');
      }
      if (icon) {
        icon.classList.remove('rotate-180', 'bg-primary', 'text-white', 'border-primary');
      }
      if (btn) {
        btn.setAttribute('aria-expanded', 'false');
        btn.classList.remove('border-primary', 'shadow-md');
        btn.classList.add('border-gray-200');
      }
    });

    if (isClosingCurrent) {
      activePanel = null;
      return;
    }

    // Desplegar el panel seleccionado
    activePanel = targetKey;
    const selectedPanel = panels[targetKey];
    const selectedIcon = icons[targetKey];
    const selectedBtn = document.querySelector(`[data-booking-toggle="${targetKey}"]`);

    if (selectedPanel) {
      selectedPanel.classList.remove('hidden');
      requestAnimationFrame(() => {
        selectedPanel.classList.remove('opacity-0', 'translate-y-4');
        selectedPanel.classList.add('opacity-100', 'translate-y-0');
      });
    }
    if (selectedIcon) {
      selectedIcon.classList.add('rotate-180', 'bg-primary', 'text-white', 'border-primary');
    }
    if (selectedBtn) {
      selectedBtn.setAttribute('aria-expanded', 'true');
      selectedBtn.classList.remove('border-gray-200');
      selectedBtn.classList.add('border-primary', 'shadow-md');
    }
  }

  toggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-booking-toggle');
      if (key) setPanelState(key);
    });
  });
</script>
