---
import { hotelsyncSteps, whatsappSteps, hotelsyncUrl, whatsappUrl } from '../data/site';
---

<section id="reservar" class="bg-sand py-16 sm:py-28" aria-labelledby="reservar-title">
  <div class="max-w-page mx-auto px-5 sm:px-10">
    <h2 id="reservar-title" class="font-display text-3xl sm:text-[2.75rem] leading-[1.15]">Cómo reservar</h2>
    <p class="mt-3 text-stone max-w-[52ch]">Dos caminos. Elige el que te acomode.</p>

    <div class="mt-10 sm:mt-14 grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div>
        <h3 class="font-display text-2xl">En línea</h3>
        <p class="mt-1 text-stone">Pago en línea y confirmación inmediata.</p>
        <ol class="mt-6 border-t border-ink/10">
          {hotelsyncSteps.map((step, i) => (
            <li class="flex gap-5 py-4 border-b border-ink/10">
              <span class="w-6 shrink-0 font-display text-xl text-terracotta leading-7" aria-hidden="true">{i + 1}</span>
              <p><span class="font-semibold">{step.title}.</span> <span class="text-stone">{step.text}</span></p>
            </li>
          ))}
        </ol>
        <a
          href={hotelsyncUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex items-center justify-center h-12 px-7 rounded-ctl bg-terracotta hover:bg-terracotta-dark text-white font-medium transition-colors"
        >
          Ver disponibilidad
        </a>
      </div>

      <div>
        <h3 class="font-display text-2xl">Por WhatsApp</h3>
        <p class="mt-1 text-stone">Hablas directo con recepción, a cualquier hora.</p>
        <ol class="mt-6 border-t border-ink/10">
          {whatsappSteps.map((step, i) => (
            <li class="flex gap-5 py-4 border-b border-ink/10">
              <span class="w-6 shrink-0 font-display text-xl text-terracotta leading-7" aria-hidden="true">{i + 1}</span>
              <p><span class="font-semibold">{step.title}.</span> <span class="text-stone">{step.text}</span></p>
            </li>
          ))}
        </ol>
        <a
          href={whatsappUrl('Hola, quiero consultar disponibilidad en Cabañas Pinamar.')}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex items-center justify-center gap-2 h-12 px-7 rounded-ctl bg-whatsapp hover:bg-whatsapp-dark text-ink font-medium transition-colors"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z" /></svg>
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
