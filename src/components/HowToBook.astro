---
import HowToBookIsland from './HowToBookIsland.vue';

interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section id="como-reservar" class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 bg-background border-t border-gray-200/80">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado Editorial -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-14">
      <p class="text-xs uppercase tracking-widest text-accent font-bold mb-3">
        GUÍA PASO A PASO
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary tracking-tight leading-snug mb-4">
        ¿Cómo Reservar tu Estadía?
      </h2>
      <p class="text-gray-700 leading-relaxed text-base">
        Selecciona el canal de tu preferencia para desplegar el paso a paso de tu reserva.
      </p>
    </div>

    <!-- Isla Vue 3 para el Despliegue Responsivo de Pasos -->
    <HowToBookIsland client:visible hotelSyncUrl={hotelSyncUrl} />
  </div>
</section>
