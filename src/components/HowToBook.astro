---
import HowToBookIsland from './HowToBookIsland.vue';

interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section id="como-reservar" class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 bg-transparent">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block bg-white text-pinamar-navy text-xs uppercase tracking-widest font-bold px-3.5 py-1 mb-3 border border-amber-900/10 shadow-sm">
        GUÍA PASO A PASO
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy tracking-tight leading-snug mb-4">
        ¿Cómo <span class="italic font-normal text-sunset-5">Reservar</span> tu Estadía?
      </h2>
      <!-- Línea Decorativa con el Degradado Vivo del Logo al 100% de Saturación -->
      <div class="w-24 h-1 mx-auto bg-logo-vivid-line bg-gradient-to-r from-[#f9c116] to-[#e76a14] mb-5"></div>
      <p class="text-pinamar-navy/80 leading-relaxed text-base">
        Selecciona el canal de tu preferencia para desplegar el paso a paso de tu reserva.
      </p>
    </div>

    <HowToBookIsland client:visible hotelSyncUrl={hotelSyncUrl} />
  </div>
</section>
