---
import BookingForm from './BookingForm.astro';

const title = 'Tu lugar en La Serena, a pasos del mar';
const subtitle = 'Cabañas familiares desde hace más de 25 años, a 5 minutos a pie de la playa de Peñuelas.';
---

<!--
  Portada "panorámica". Regla: el buscador completo debe verse sin hacer scroll.
  - Escritorio: la foto toma el alto que sobra de la pantalla (100svh menos header, título y buscador),
    con mínimo 15rem y máximo 34rem; el buscador se monta sobre su borde inferior.
  - Teléfono: título, buscador y después la foto.
-->
<section class="max-w-page mx-auto px-5 sm:px-10 pt-8 sm:pt-10 lg:pt-12 pb-6 flex flex-col" aria-labelledby="hero-title">
  <div class="order-1 grid lg:grid-cols-12 gap-4 lg:gap-14 items-end">
    <h1 id="hero-title" class="lg:col-span-7 font-display text-[2.375rem] leading-[1.08] sm:text-[3.25rem] lg:text-[3.75rem] max-w-[20ch] text-balance">
      {title}
    </h1>
    <p class="lg:col-span-5 text-lg lg:text-xl text-stone max-w-[40ch] lg:pb-2">{subtitle}</p>
  </div>

  <img
    src="/fotos/panoramica-2000.webp"
    srcset="/fotos/panoramica-1200.webp 1200w, /fotos/panoramica-2000.webp 2000w"
    sizes="(min-width:1280px) 1200px, 100vw"
    alt="Vista aérea de Cabañas Pinamar: techos rojos, palmeras y los cerros de La Serena"
    width="2000"
    height="908"
    fetchpriority="high"
    class="order-3 lg:order-2 mt-8 w-full aspect-[16/9] sm:aspect-[2.2/1] lg:aspect-auto lg:h-[clamp(15rem,calc(100svh-29rem),34rem)] object-cover rounded-[4px] shadow-[0_26px_50px_-28px_rgb(31_43_42/0.55)]"
  />

  <div class="order-2 lg:order-3 relative z-10 mt-6 lg:-mt-24 lg:mx-14">
    <BookingForm idPrefix="hero" />
  </div>
</section>
