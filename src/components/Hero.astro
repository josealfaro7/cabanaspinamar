---
interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section class="relative pt-4 pb-14 sm:pt-8 sm:pb-20 px-4 sm:px-8">
  <!-- Tarjeta Panorámica Dark-Luxe Pacífico Profundo con Curvas Orgánicas (rounded-3xl) -->
  <div class="max-w-7xl mx-auto">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#071A33] via-[#0A2246] to-[#12315E] text-white shadow-[0_25px_60px_-15px_rgba(10,34,70,0.35)] p-6 sm:p-12 lg:p-16">
      <!-- Halo Cálido de Atardecer en el Interior del Hero -->
      <div
        class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-gradient-to-br from-[#FCE600]/25 via-[#F59B00]/20 to-[#E86F2C]/10 blur-3xl"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -bottom-28 left-1/3 w-80 h-80 rounded-full bg-[#E86F2C]/15 blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Columna de Texto Principal (7 Columnas) -->
        <div class="lg:col-span-7 text-left">
          <h1 class="font-serif text-3xl sm:text-5xl lg:text-[3.35rem] font-semibold text-white tracking-tight leading-[1.15] mb-6">
            Más de <span class="italic font-normal text-[#F9C600]">25 años</span> siendo parte de tus estadías. Tu lugar en La Serena <span class="italic font-normal text-[#FF9E5E]">a pasos del mar.</span>
          </h1>

          <p class="text-white/80 text-base sm:text-lg leading-relaxed max-w-2xl mb-9">
            Un refugio cálido y familiar a solo 5 minutos caminando de la playa de Peñuelas, con atención las 24 horas y desayuno incluido.
          </p>

          <!-- Cápsula de Reserva Directa (Bento Pill Card) -->
          <div class="bg-white/95 backdrop-blur-md text-[#0A2246] rounded-2xl p-5 sm:p-6 shadow-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <span class="block text-[11px] uppercase tracking-widest text-[#E86F2C] font-bold mb-0.5">
                RESERVA ONLINE OFICIAL
              </span>
              <p class="font-serif text-xl sm:text-2xl font-bold text-[#0A2246]">
                Reserva tu <span class="italic font-normal text-[#E86F2C]">estadía hoy</span>
              </p>
            </div>

            <a
              href={hotelSyncUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] rounded-full bg-gradient-to-r from-[#E86F2C] to-[#F59B00] hover:from-[#d65f1e] hover:to-[#e08c00] text-white font-bold text-xs uppercase tracking-widest px-8 py-4 shadow-md transition-all duration-300 ease-in-out"
            >
              Ver Disponibilidad
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Fotografía Costera con Marco Orgánico Curvo -->
        <div class="lg:col-span-5 relative">
          <div class="relative bg-white/10 backdrop-blur-sm p-3 rounded-3xl border border-white/15 shadow-2xl">
            <div class="relative aspect-[4/5] overflow-hidden rounded-2xl">
              <img
                src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=80&fm=webp"
                alt="Atardecer costero y Cabañas Pinamar en La Serena"
                class="w-full h-full object-cover"
                loading="eager"
              />
              <!-- Sello Flotante con el Logo Original -->
              <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm p-2.5 rounded-2xl shadow-lg">
                <img
                  src="/logocabanas.png"
                  alt="Emblema Cabañas Pinamar"
                  class="w-14 h-14 object-contain"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
