---
interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section class="relative overflow-hidden bg-pinamar-gradient pt-10 pb-24 sm:pt-16 sm:pb-32">
  <!-- Bandas Retro Escalonadas del Logo (Sutiles en el fondo) -->
  <div class="absolute inset-0 bg-pinamar-stripes opacity-55 pointer-events-none"></div>

  <!-- Sol Circular Difuminado del Logo (#FFFAC2 / pinamar-sun) -->
  <div
    class="
      pointer-events-none absolute top-10 left-[12%] sm:left-[18%]
      w-44 h-44 sm:w-72 sm:h-72 rounded-full bg-pinamar-sun
      shadow-[0_0_90px_30px_rgba(255,250,194,0.75)] opacity-90
    "
    aria-hidden="true"
  ></div>

  <!-- Contenedor Principal en Blanco Puro / Glassmorphism Cálido -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8">
    <div class="bg-white/95 backdrop-blur-md shadow-2xl border border-amber-900/10 p-3 sm:p-5">
      <!-- Marco Interior Punteado (Guiño directo al borde punteado del logo) -->
      <div class="border-2 border-dotted border-[#0A2246]/30 p-6 sm:p-12 lg:p-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Columna de Texto Principal (7 Columnas) -->
          <div class="lg:col-span-7 text-left">
            <div class="inline-flex items-center gap-2.5 bg-pinamar-sun border border-amber-900/15 px-4 py-1.5 mb-6">
              <span class="w-2 h-2 rounded-full bg-sunset-5"></span>
              <span class="text-xs uppercase tracking-widest font-bold text-pinamar-navy">
                TRADICIÓN Y DESCANSO · AV. PACÍFICO 5020
              </span>
            </div>

            <h1 class="font-serif text-3xl sm:text-5xl lg:text-[3.2rem] font-bold text-pinamar-navy tracking-tight leading-[1.18] mb-6">
              Más de <span class="italic font-normal text-sunset-5">25 años</span> siendo parte de tus estadías. Tu lugar en La Serena <span class="italic font-normal text-sunset-5">a pasos del mar.</span>
            </h1>

            <p class="text-pinamar-navy/80 text-base sm:text-lg leading-relaxed mb-8">
              Un refugio cálido y familiar a solo 5 minutos caminando de la playa de Peñuelas, con atención las 24 horas y desayuno incluido.
            </p>

            <!-- Barra Flotante de Reserva Directa en Blanco Puro Sólido (bg-white + border-amber-900/10) -->
            <div class="bg-white p-5 sm:p-6 shadow-md border border-amber-900/10 border-l-4 border-l-sunset-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <span class="block text-[11px] uppercase tracking-widest text-sunset-4 font-bold mb-0.5">
                  RESERVA ONLINE OFICIAL
                </span>
                <p class="font-serif text-xl sm:text-2xl font-bold text-pinamar-navy">
                  Reserva tu <span class="italic font-normal text-sunset-5">estadía hoy</span>
                </p>
              </div>

              <!-- Botón Primario en #E63B06 (sunset-5) con hover en #F06A00 (sunset-4) -->
              <a
                href={hotelSyncUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] bg-sunset-5 hover:bg-sunset-4 text-white font-bold text-xs uppercase tracking-widest px-8 py-4 shadow-sm transition-all duration-300 ease-in-out"
              >
                Ver Disponibilidad
              </a>
            </div>
          </div>

          <!-- Columna Derecha: Sello Visual Retro-Sunset + Fotografía Costera -->
          <div class="lg:col-span-5 relative">
            <div class="relative bg-white p-3 shadow-xl border border-amber-900/10">
              <div class="relative aspect-[4/5] overflow-hidden">
                <img
                  src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=80&fm=webp"
                  alt="Atardecer costero y Cabañas Pinamar en La Serena"
                  class="w-full h-full object-cover"
                  loading="eager"
                />
                <!-- Sello Flotante con el Logo Original -->
                <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm p-2 shadow-lg border border-amber-900/10">
                  <img
                    src="/logocabanas.png"
                    alt="Emblema Cabañas Pinamar"
                    class="w-14 h-14 object-contain"
                  />
                </div>
              </div>

              <!-- Pie de foto estilo postal costera -->
              <div class="pt-3 pb-1 px-2 flex items-center justify-between text-xs font-bold text-pinamar-navy">
                <span class="uppercase tracking-widest">PLAYA DE PEÑUELAS</span>
                <span class="text-sunset-5">★ 9,7 LIMPIEZA</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Divisor Inferior SVG de Horizonte / Ola en color #fffdf7 para fundirse con el inicio del degradado continuo -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none">
    <svg
      class="relative block w-full h-12 sm:h-20 text-[#fffdf7]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
    >
      <path
        fill="currentColor"
        d="M0,48L80,53.3C160,59,320,69,480,69.3C640,69,800,59,960,48C1120,37,1280,27,1360,21.3L1440,16L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"
      ></path>
    </svg>
  </div>
</section>
