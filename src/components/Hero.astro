---
import { HOTELSYNC_ENGINE, HOTELSYNC_CODE, whatsappUrl } from '../data/site';
---

<section class="relative" aria-labelledby="hero-title">
  <div class="relative h-[min(72svh,46rem)] min-h-[26rem] overflow-hidden bg-ink">
    <img
      src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=2000&q=75&fm=webp"
      srcset="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=900&q=70&fm=webp 900w, https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=2000&q=75&fm=webp 2000w"
      sizes="100vw"
      alt="Atardecer en la costa"
      width="2000"
      height="1333"
      fetchpriority="high"
      class="hero-photo absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/20 to-transparent" aria-hidden="true"></div>

    <div class="relative h-full max-w-page mx-auto px-5 sm:px-10 flex flex-col justify-end pb-10 sm:pb-24 lg:pb-32">
      <h1 id="hero-title" class="font-display text-bone text-[2.25rem] leading-[1.1] sm:text-6xl lg:text-7xl max-w-[16ch] text-balance">
        Tu lugar en La Serena, a pasos del mar
      </h1>
      <p class="mt-4 sm:mt-6 text-bone/90 text-lg sm:text-xl max-w-[38ch]">
        Cabañas familiares desde hace más de 25 años, a 5 minutos a pie de la playa de Peñuelas.
      </p>
    </div>
    <p class="absolute right-0 bottom-0 bg-ink/70 text-bone text-[11px] px-2 py-0.5">Imagen referencial</p>
  </div>

  <!-- Panel de reserva: formulario real hacia HotelSync -->
  <div class="max-w-page mx-auto sm:px-10 sm:-mt-14 lg:-mt-16 relative z-10">
    <form
      action={HOTELSYNC_ENGINE}
      method="get"
      target="_blank"
      class="bg-white sm:shadow-[0_18px_40px_-20px_rgb(31_43_42/0.35)] px-5 py-6 sm:p-7 grid grid-cols-2 sm:grid-cols-[1fr_1fr_auto] lg:grid-cols-[1fr_1fr_auto_auto] gap-4 sm:gap-5 items-end"
      aria-label="Ver disponibilidad"
    >
      <input type="hidden" name="engine_code" value={HOTELSYNC_CODE} />
      <label class="flex flex-col gap-2">
        <span class="text-[13px] font-semibold uppercase tracking-[0.08em] text-stone">Adultos</span>
        <select name="adults" class="h-12 rounded-ctl border border-ink/20 bg-bone px-3 text-base">
          {[1, 2, 3, 4, 5, 6, 7].map((n) => <option value={n} selected={n === 2}>{n}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-2">
        <span class="text-[13px] font-semibold uppercase tracking-[0.08em] text-stone">Niños</span>
        <select name="children" class="h-12 rounded-ctl border border-ink/20 bg-bone px-3 text-base">
          {[0, 1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>
      <button
        type="submit"
        class="col-span-2 sm:col-span-1 h-12 px-7 rounded-ctl bg-terracotta hover:bg-terracotta-dark text-white font-medium transition-colors"
      >
        Ver disponibilidad
      </button>
      <a
        href={whatsappUrl('Hola, quiero consultar disponibilidad en Cabañas Pinamar.')}
        target="_blank"
        rel="noopener noreferrer"
        class="col-span-2 sm:col-span-3 lg:col-span-1 inline-flex items-center justify-center gap-2 h-12 px-2 text-ink underline underline-offset-4 decoration-ink/30 hover:decoration-ink"
      >
        o pregunta por WhatsApp
      </a>
      <p class="col-span-2 sm:col-span-3 lg:col-span-4 text-sm text-stone -mt-1">
        Eliges las fechas y la cabaña en el siguiente paso. Pago en línea y confirmación inmediata.
      </p>
    </form>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo {
      animation: settle 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes settle {
      from {
        transform: scale(1.04);
      }
      to {
        transform: scale(1);
      }
    }
  }
</style>
