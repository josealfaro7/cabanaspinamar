---
interface Props {
  hotelSyncUrl?: string;
}

const {
  hotelSyncUrl = 'https://app.hotelsync.com/engine/es?engine_code=e0dacb55418a3ad29a5f9d07b988ba218e10eeb0&adults=2&children=0',
} = Astro.props;
---

<section class="relative bg-transparent pt-10 pb-12 sm:pt-16 sm:pb-16">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8">
    <!-- Postal: superficie blanca única con el borde punteado del logo trazado hacia adentro -->
    <div class="bg-white shadow-xl outline-2 outline-dotted outline-pinamar-navy/30 [outline-offset:-12px] sm:[outline-offset:-20px] p-8 sm:p-16 lg:p-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Columna de Texto Principal (7 Columnas) -->
          <div class="lg:col-span-7 text-left">
            <h1 class="font-serif text-3xl sm:text-5xl lg:text-[3.2rem] font-bold text-pinamar-navy tracking-tight leading-[1.18] mb-6">
              Más de <span class="italic font-normal text-action">25 años</span> siendo parte de tus estadías. Tu lugar en La Serena <span class="italic font-normal text-action">a pasos del mar.</span>
            </h1>

            <p class="text-pinamar-navy/80 text-base sm:text-lg leading-relaxed mb-8">
              Un refugio cálido y familiar a solo 5 minutos caminando de la playa de Peñuelas, con atención las 24 horas y desayuno incluido.
            </p>

            <a
              href={hotelSyncUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] bg-action hover:bg-action-hover text-white font-bold text-xs uppercase tracking-widest px-8 py-4 shadow-md transition-colors duration-200"
            >
              Ver disponibilidad y reservar
            </a>
          </div>

          <!-- Columna Derecha: Fotografía (solo desktop) -->
          <div class="hidden lg:block lg:col-span-5">
            <div class="aspect-[4/5] overflow-hidden">
              <img
                src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=80&fm=webp"
                  alt="Atardecer en la costa"
                  class="w-full h-full object-cover"
                  width="1200"
                  height="1500"
                  loading="lazy"
                  decoding="async"
              />
            </div>
          </div>
        </div>
    </div>
  </div>
</section>
