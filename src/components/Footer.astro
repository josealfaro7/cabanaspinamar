---
---

<footer id="contacto" class="bg-pinamar-navy text-pinamar-ice mt-auto relative">
  <!-- Franja Superior Retro-Sunset de 5 Tonos -->
  <div class="grid grid-cols-5 h-2 w-full">
    <div class="bg-[#FCE600]"></div>
    <div class="bg-[#F9C600]"></div>
    <div class="bg-[#F59B00]"></div>
    <div class="bg-[#F06A00]"></div>
    <div class="bg-[#E63B06]"></div>
  </div>

  <div class="max-w-7xl mx-auto py-16 sm:py-20 px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 pb-12 border-b-2 border-dotted border-pinamar-ice/20">
      <!-- Marca y Redes -->
      <div class="space-y-6">
        <div class="flex items-center">
          <img
            src="/logocabanas.png"
            alt="Cabañas Pinamar"
            class="h-14 w-auto bg-pinamar-ice p-1 rounded-full shadow-md"
          />
          <span class="font-serif text-2xl font-bold text-pinamar-ice ml-3.5">
            Cabañas Pinamar
          </span>
        </div>

        <div>
          <a
            href="https://www.instagram.com/cabanaspinamarchile/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Cabañas Pinamar"
            class="inline-flex items-center gap-3 text-xs uppercase tracking-widest text-pinamar-sun hover:text-sunset-2 transition-all duration-300 ease-in-out"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
              <rect width="20" height="20" x="2" y="2"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
            <span>@cabanaspinamarchile</span>
          </a>
        </div>
      </div>

      <!-- Contacto y Dirección -->
      <div class="space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-sunset-2 font-bold">
          Contacto
        </h3>
        <div class="space-y-2 text-sm text-pinamar-ice/90">
          <p>
            <a href="tel:+56974635702" class="hover:text-pinamar-sun transition-all duration-300 ease-in-out">
              +56 9 7463 5702
            </a>
            <span class="mx-2 text-pinamar-ice/40">|</span>
            <a href="mailto:cabanapinamar.chile@gmail.com" class="hover:text-pinamar-sun transition-all duration-300 ease-in-out">
              cabanapinamar.chile@gmail.com
            </a>
          </p>
          <p class="text-pinamar-ice/80">
            Avenida Pacífico 5020, La Serena, Coquimbo.
          </p>
        </div>
      </div>

      <!-- Políticas -->
      <div class="space-y-4">
        <h3 class="text-xs uppercase tracking-widest text-sunset-2 font-bold">
          Políticas
        </h3>
        <p class="text-sm text-pinamar-ice/90 leading-relaxed">
          Entrada 15:00 - 00:00 | Salida 12:00. Cancelación sujeta a tarifa.
        </p>
      </div>
    </div>

    <div class="pt-8 text-center text-xs uppercase tracking-widest text-pinamar-ice/60">
      <p>Cabañas Pinamar · Avenida Pacífico 5020, La Serena, Coquimbo.</p>
    </div>
  </div>
</footer>
