---
import { contact, policies, hotelsyncUrl, whatsappUrl } from '../data/site';
---

<footer id="contacto" class="bg-ink text-bone" data-hide-mobile-bar>
  <div class="max-w-page mx-auto px-5 sm:px-10 py-16 sm:py-20 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <img src="/logocabanas.webp" alt="" width="48" height="48" loading="lazy" class="w-12 h-12 bg-bone rounded-full p-0.5" />
        <p class="font-display text-2xl">Cabañas Pinamar</p>
      </div>
      <p class="mt-5 text-bone/75 max-w-[36ch]">Cabañas familiares en La Serena desde hace más de 25 años.</p>
      <a
        href={hotelsyncUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex items-center justify-center h-12 px-7 rounded-ctl bg-terracotta hover:bg-terracotta-dark text-white font-medium transition-colors"
      >
        Ver disponibilidad
      </a>
    </div>

    <div class="md:col-span-4">
      <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-bone/70">Contacto</h2>
      <ul class="mt-3">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] hover:underline underline-offset-4">WhatsApp {contact.phoneLabel}</a></li>
        <li><a href={contact.phoneHref} class="inline-flex items-center min-h-[44px] hover:underline underline-offset-4">Llamar {contact.phoneLabel}</a></li>
        <li><a href={`mailto:${contact.email}`} class="inline-flex items-center min-h-[44px] hover:underline underline-offset-4 break-all">{contact.email}</a></li>
        <li><a href={contact.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] hover:underline underline-offset-4">Instagram {contact.instagramHandle}</a></li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-bone/70">Horarios</h2>
      <dl class="mt-4 space-y-3 text-bone/90">
        <div><dt class="inline">Llegada:</dt> <dd class="inline">{policies.checkIn}</dd></div>
        <div><dt class="inline">Salida:</dt> <dd class="inline">hasta las {policies.checkOut}</dd></div>
        <div><dd>{policies.cancellation}</dd></div>
      </dl>
    </div>
  </div>
  <div class="border-t border-bone/15">
    <p class="max-w-page mx-auto px-5 sm:px-10 py-6 text-sm text-bone/70">Cabañas Pinamar · {contact.address}</p>
  </div>
</footer>
