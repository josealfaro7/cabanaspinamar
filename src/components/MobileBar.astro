---
import { hotelsyncUrl, whatsappUrl } from '../data/site';
---

<!-- Barra de reserva fija solo en teléfonos.
     Se oculta mientras hay otro buscador o botón de reserva en pantalla, para no duplicarlo. -->
<div id="mobile-bar" class="sm:hidden fixed inset-x-0 bottom-0 z-40 transition-[transform,opacity] duration-200 ease-out motion-reduce:transition-none data-[hidden=true]:translate-y-full data-[hidden=true]:opacity-0 data-[hidden=true]:pointer-events-none bg-bone/95 backdrop-blur border-t border-ink/10 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] grid grid-cols-[1fr_auto] gap-3">
  <a
    href={hotelsyncUrl()}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center h-12 rounded-ctl bg-terracotta text-white font-medium"
  >
    Ver disponibilidad
  </a>
  <a
    href={whatsappUrl('Hola, quiero consultar disponibilidad en Cabañas Pinamar.')}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center w-12 h-12 rounded-ctl bg-whatsapp text-ink"
    aria-label="Escribir por WhatsApp"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z" /></svg>
  </a>
</div>

<script>
  const bar = document.getElementById('mobile-bar');
  const targets = document.querySelectorAll('[data-booking-form], [data-hide-mobile-bar]');
  if (bar && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const hide = visible.size > 0;
      bar.dataset.hidden = String(hide);
      bar.toggleAttribute('inert', hide);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        update();
      },
      { threshold: 0.15 }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
