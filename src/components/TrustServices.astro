---
// Servicios del recinto. El ícono es el contenido interno de un SVG 24x24 (trazo 1.75).
const services = [
  { title: "Desayuno incluido", text: "Para comenzar cada mañana sin preocupaciones.", icon: `<path d="M17 8h1a4 4 0 1 1 0 8h-1"></path> <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path> <line x1="6" x2="6" y1="2" y2="4"></line> <line x1="10" x2="10" y1="2" y2="4"></line> <line x1="14" x2="14" y1="2" y2="4"></line>` },
  { title: "Recepción 24 horas", text: "Atención continua durante toda tu estadía.", icon: `<circle cx="12" cy="12" r="10"></circle> <polyline points="12 6 12 12 16 14"></polyline>` },
  { title: "Pet Friendly", text: "Tus mascotas son bienvenidas en nuestras instalaciones.", icon: `<circle cx="11" cy="4" r="2"></circle> <circle cx="18" cy="8" r="2"></circle> <circle cx="20" cy="16" r="2"></circle> <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>` },
  { title: "Estacionamiento privado", text: "Acceso directo y seguro dentro del recinto.", icon: `<rect width="18" height="18" x="3" y="3"></rect> <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>` },
  { title: "WiFi de alta velocidad", text: "Conexión gratuita en todas las cabañas y áreas.", icon: `<path d="M12 20h.01"></path> <path d="M2 8.82a15 15 0 0 1 20 0"></path> <path d="M5 12.859a10 10 0 0 1 14 0"></path> <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>` },
  { title: "Terraza común y taca-taca", text: "Espacios renovados para compartir en familia.", icon: `<circle cx="12" cy="12" r="4"></circle> <path d="M12 2v2"></path> <path d="M12 20v2"></path> <path d="m4.93 4.93 1.41 1.41"></path> <path d="m17.66 17.66 1.41 1.41"></path> <path d="M2 12h2"></path> <path d="M20 12h2"></path>` },
  { title: "Zona de juegos infantiles", text: "Parque seguro dentro del recinto para los niños.", icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path> <circle cx="9" cy="7" r="4"></circle> <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path> <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>` },
  { title: "Minimarket 24 horas", text: "Venta de snacks y bebidas en recepción.", icon: `<path d="M6 2 3 6v14h18V6l-3-4Z"></path> <path d="M3 6h18"></path> <path d="M16 10a4 4 0 0 1-8 0"></path>` },
];
---

<section class="py-14 sm:py-20 px-4 sm:px-8 lg:px-12 max-w-7xl mx-auto">
  <!-- Datos de trayectoria: en línea, sin tarjeta -->
  <dl class="reveal-on-scroll grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-0 sm:divide-x divide-pinamar-navy/15 max-w-3xl mx-auto mb-20 sm:mb-24 text-center">
    <div class="flex flex-col-reverse items-center sm:px-8">
      <dt class="text-sm text-pinamar-navy/80 mt-2">Años de tradición familiar en La Serena</dt>
      <dd class="font-serif text-5xl sm:text-6xl font-bold text-pinamar-navy">+25</dd>
    </div>
    <div class="flex flex-col-reverse items-center sm:px-8">
      <dt class="text-sm text-pinamar-navy/80 mt-2">Cabañas equipadas a pasos del mar</dt>
      <dd class="font-serif text-5xl sm:text-6xl font-bold text-pinamar-navy">21</dd>
    </div>
  </dl>

  <div class="reveal-on-scroll text-center mb-12">
    <h2 class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy mb-4">
      Servicios e <span class="italic font-normal text-action">instalaciones</span>
    </h2>
    <div class="w-24 h-1 mx-auto bg-logo-line" aria-hidden="true"></div>
  </div>

  <!-- Una sola superficie; los servicios se separan con líneas, no con tarjetas -->
  <ul class="reveal-on-scroll shadow-xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-pinamar-navy/10">
    {services.map((service) => (
      <li class="bg-white p-6 sm:p-8 flex gap-4 items-start">
        <span class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter" set:html={service.icon} />
        </span>
        <div>
          <h3 class="font-bold text-pinamar-navy text-sm leading-snug">{service.title}</h3>
          <p class="text-sm text-pinamar-navy/75 mt-1 leading-relaxed">{service.text}</p>
        </div>
      </li>
    ))}
  </ul>

  <!-- Próximamente -->
  <p class="reveal-on-scroll bg-pinamar-navy text-white p-6 sm:p-8 mt-8 flex flex-col md:flex-row items-center gap-4 text-center md:text-left text-sm leading-relaxed">
    <span class="inline-block bg-pinamar-sun text-pinamar-navy text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 shrink-0">Próximamente</span>
    <span>Seguimos creciendo junto a ti: estamos construyendo un <span class="font-serif italic text-pinamar-sun text-base">nuevo salón comedor</span> para el servicio de desayuno.</span>
  </p>
</section>
