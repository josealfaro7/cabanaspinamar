---
const metrics = [
  {
    value: '+25',
    label: 'Años de tradición familiar en La Serena',
    badge: 'Trayectoria',
  },
  {
    value: '9,7',
    label: 'Calificación sobresaliente en Limpieza',
    badge: 'Excelencia',
  },
  {
    value: '21',
    label: 'Cabañas totalmente equipadas',
    badge: 'Capacidad',
  },
];

const services = [
  {
    title: 'A pasos de la playa',
    description: 'Camina 5 minutos hasta la arena de Playa Peñuelas.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 18c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0"/><path d="M2 22c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0"/><path d="M12 2a4 4 0 0 1 4 4v2H8V6a4 4 0 0 1 4-4Z"/></svg>`,
  },
  {
    title: 'Recepción 24 hrs',
    description: 'Asistencia permanente y llegada flexible.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>`,
  },
  {
    title: 'Desayuno incluido',
    description: 'Comienza cada mañana con energía frente a la costa.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/></svg>`,
  },
  {
    title: 'Estacionamiento',
    description: 'Acceso vehicular privado y seguro dentro del recinto.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="18" height="18" x="3" y="3" rx="3"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>`,
  },
  {
    title: 'Wi-Fi',
    description: 'Conexión inalámbrica estable en todas las instalaciones.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 20h.01"/><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.859a10 10 0 0 1 14 0"/><path d="M8.5 16.429a5 5 0 0 1 7 0"/></svg>`,
  },
  {
    title: 'Juegos',
    description: 'Espacios recreativos pensados para disfrutar en familia.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>`,
  },
  {
    title: '100% Pet Friendly',
    description: 'Tus mascotas son bienvenidas como parte de tu familia.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>`,
  },
  {
    title: 'Terraza común nueva',
    description: 'Área renovada al aire libre para compartir al atardecer.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 2v4"/><path d="m4.93 4.93 2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="m16.24 7.76 2.83-2.83"/><path d="M16 12a4 4 0 0 0-8 0"/><path d="M3 16h18"/><path d="M5 20h14"/></svg>`,
  },
];
---

<section class="py-12 sm:py-20 px-4 sm:px-8 lg:px-12">
  <div class="max-w-7xl mx-auto">
    <!-- 1. Bento Grid de Métricas Clave (Números en color uniforme #0A2246) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {metrics.map((metric, idx) => (
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white rounded-3xl p-8 sm:p-10 shadow-[0_14px_35px_-12px_rgba(10,34,70,0.08)] border border-[#0A2246]/10 flex flex-col justify-between"
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <div class="flex items-center justify-between mb-4">
            <span class="inline-block rounded-full bg-[#FFF5DF] text-[#E86F2C] text-[11px] uppercase tracking-widest font-bold px-3.5 py-1">
              {metric.badge}
            </span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#F59B00]"></span>
          </div>
          <div>
            <p class="font-serif text-5xl sm:text-6xl font-bold text-[#0A2246] tracking-tight mb-2">
              {metric.value}
            </p>
            <p class="text-sm text-[#0A2246]/75 font-medium leading-relaxed">
              {metric.label}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- 2. Encabezado de Servicios -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block rounded-full bg-white text-[#E86F2C] text-xs uppercase tracking-widest font-bold px-4 py-1.5 mb-3 border border-[#0A2246]/10 shadow-sm">
        COMODIDAD FRENTE AL MAR
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#0A2246] tracking-tight mb-3">
        Servicios <span class="italic font-normal text-[#E86F2C]">Incluidos</span> en tu Estadía
      </h2>
      <p class="text-[#0A2246]/75 text-base leading-relaxed">
        Todo dispuesto para que disfrutes de La Serena con total tranquilidad y espíritu familiar.
      </p>
    </div>

    <!-- 3. Bento Grid Orgánico de 8 Servicios -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {services.map((service, index) => (
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white rounded-2xl p-6 sm:p-7 shadow-[0_10px_28px_-10px_rgba(10,34,70,0.07)] hover:shadow-[0_18px_38px_-10px_rgba(232,111,44,0.18)] border border-[#0A2246]/8 hover:border-[#E86F2C]/40 hover:-translate-y-1 flex flex-col justify-between group"
          style={`transition-delay: ${(index % 4) * 90}ms;`}
        >
          <div class="w-12 h-12 rounded-2xl bg-[#FFF6E5] group-hover:bg-[#E86F2C] text-[#E86F2C] group-hover:text-white flex items-center justify-center mb-5 transition-colors duration-300" set:html={service.icon} />
          <div>
            <h3 class="font-serif text-lg font-bold text-[#0A2246] mb-1.5">
              {service.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#0A2246]/70 leading-relaxed">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
