---
---

<section class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12 max-w-7xl mx-auto bg-transparent">
  <!-- 1. Bloque Superior de Métricas en Blanco Puro Sólido (bg-white shadow-xl) flotando sobre el degradado -->
  <div class="bg-white p-2.5 shadow-xl border border-amber-900/10 mb-16">
    <div class="border-2 border-dotted border-[#0A2246]/25 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-amber-900/10">
      <!-- Columna 1 -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-10 text-center"
        style="transition-delay: 0ms;"
      >
        <span class="inline-block bg-pinamar-sun text-pinamar-navy text-xs tracking-widest uppercase font-bold px-3 py-1 mb-3">
          TRAYECTORIA
        </span>
        <p class="font-serif text-4xl sm:text-5xl font-bold text-pinamar-navy mb-2">
          +25
        </p>
        <p class="text-sm text-pinamar-navy/75">
          Años de tradición familiar en La Serena
        </p>
      </div>

      <!-- Columna 2 -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-10 text-center"
        style="transition-delay: 120ms;"
      >
        <span class="inline-block bg-pinamar-sun text-pinamar-navy text-xs tracking-widest uppercase font-bold px-3 py-1 mb-3">
          EXCELENCIA
        </span>
        <p class="font-serif text-4xl sm:text-5xl font-bold text-pinamar-navy mb-2">
          9,7
        </p>
        <p class="text-sm text-pinamar-navy/75">
          Calificación sobresaliente en Limpieza
        </p>
      </div>

      <!-- Columna 3 -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-10 text-center"
        style="transition-delay: 240ms;"
      >
        <span class="inline-block bg-pinamar-sun text-pinamar-navy text-xs tracking-widest uppercase font-bold px-3 py-1 mb-3">
          CAPACIDAD
        </span>
        <p class="font-serif text-4xl sm:text-5xl font-bold text-pinamar-navy mb-2">
          21
        </p>
        <p class="text-sm text-pinamar-navy/75">
          Cabañas totalmente equipadas a pasos del mar
        </p>
      </div>
    </div>
  </div>

  <!-- 2. Matriz de Servicios y Espacios Comunes (Celdas Blanco Puro Sólido flotantes) -->
  <div>
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center mb-12">
      <span class="inline-block text-xs tracking-widest uppercase text-sunset-5 font-bold mb-2">
        COMODIDAD Y HOSPITALIDAD
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy mb-4">
        Servicios e <span class="italic font-normal text-sunset-5">Instalaciones</span>
      </h2>
      <!-- Línea Decorativa con el Degradado Vivo del Logo al 100% de Saturación -->
      <div class="w-24 h-1 mx-auto bg-logo-vivid-line bg-gradient-to-r from-[#f9c116] to-[#e76a14]"></div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      <!-- 1. Desayuno Incluido -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 0ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
            <line x1="6" x2="6" y1="2" y2="4"></line>
            <line x1="10" x2="10" y1="2" y2="4"></line>
            <line x1="14" x2="14" y1="2" y2="4"></line>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Desayuno Incluido
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Para comenzar cada mañana sin preocupaciones.
        </p>
      </div>

      <!-- 2. Recepción 24 Horas -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 60ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Recepción 24 Horas
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Atención continua durante toda tu estadía.
        </p>
      </div>

      <!-- 3. Pet Friendly -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 120ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="11" cy="4" r="2"></circle>
            <circle cx="18" cy="8" r="2"></circle>
            <circle cx="20" cy="16" r="2"></circle>
            <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Pet Friendly
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Tus mascotas son bienvenidas en nuestras instalaciones.
        </p>
      </div>

      <!-- 4. Estacionamiento Privado -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 180ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <rect width="18" height="18" x="3" y="3"></rect>
            <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Estacionamiento Privado
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Acceso directo y seguro dentro del recinto.
        </p>
      </div>

      <!-- 5. WiFi de Alta Velocidad -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 240ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M12 20h.01"></path>
            <path d="M2 8.82a15 15 0 0 1 20 0"></path>
            <path d="M5 12.859a10 10 0 0 1 14 0"></path>
            <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          WiFi de Alta Velocidad
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Conexión gratuita en todas las cabañas y áreas.
        </p>
      </div>

      <!-- 6. Terraza Común y Taca Taca -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 300ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Terraza Común y Taca Taca
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Espacios renovados para compartir en familia.
        </p>
      </div>

      <!-- 7. Zona de Juegos Infantiles -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 360ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Zona de Juegos Infantiles
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Parque seguro dentro del recinto para los niños.
        </p>
      </div>

      <!-- 8. Minimarket 24 Horas -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-amber-900/10 shadow-xl hover:-translate-y-0.5 p-6 sm:p-8 flex flex-col items-start text-left"
        style="transition-delay: 420ms;"
      >
        <div class="w-10 h-10 bg-pinamar-sun flex items-center justify-center text-pinamar-navy shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M6 2 3 6v14h18V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h3 class="font-bold text-pinamar-navy text-sm uppercase tracking-wider mt-4">
          Minimarket 24 Horas
        </h3>
        <p class="text-xs text-pinamar-navy/70 mt-1.5 leading-relaxed">
          Venta de snacks y bebidas en recepción.
        </p>
      </div>
    </div>

    <!-- 3. Banner de Proyección Institucional -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-[#0A2246] text-white p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between mt-8 gap-4 shadow-md border-l-4 border-[#f9c116]">
      <div class="flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
        <span class="inline-block bg-[#FFFAC2] text-[#0A2246] text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 shrink-0">
          PRÓXIMAMENTE
        </span>
        <p class="text-sm text-white leading-relaxed">
          Seguimos creciendo junto a ti: estamos construyendo un <span class="font-serif italic text-[#FFFAC2] text-base">nuevo salón comedor exclusivo</span> para el servicio de desayuno.
        </p>
      </div>
    </div>
  </div>
</section>
