---
---

<section class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 max-w-7xl mx-auto">
  <!-- Layout Editorial Asimétrico: Métricas a la Izquierda (4 cols) + Matriz Abierta de Servicios a la Derecha (8 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
    <!-- Columna Izquierda: Métricas de Tradición apiladas con separadores sutiles divide-y -->
    <div class="lg:col-span-4 divide-y divide-gray-200/80 border-t border-b border-gray-200/80">
      <!-- Métrica 1 -->
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-8">
        <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
          TRAYECTORIA
        </span>
        <p class="font-serif text-5xl font-bold text-primary tracking-tight leading-none mb-3">
          +25
        </p>
        <p class="text-sm text-gray-700 leading-relaxed">
          Años de tradición familiar en La Serena
        </p>
      </div>

      <!-- Métrica 2 -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-8"
        style="transition-delay: 100ms;"
      >
        <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
          EXCELENCIA
        </span>
        <p class="font-serif text-5xl font-bold text-primary tracking-tight leading-none mb-3">
          9,7
        </p>
        <p class="text-sm text-gray-700 leading-relaxed">
          Calificación sobresaliente en Limpieza
        </p>
      </div>

      <!-- Métrica 3 -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-8"
        style="transition-delay: 200ms;"
      >
        <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
          CAPACIDAD
        </span>
        <p class="font-serif text-5xl font-bold text-primary tracking-tight leading-none mb-3">
          21
        </p>
        <p class="text-sm text-gray-700 leading-relaxed">
          Cabañas totalmente equipadas a pasos del mar
        </p>
      </div>
    </div>

    <!-- Columna Derecha: Lista Asimétrica de 8 Servicios sin Cajas Rígidas -->
    <div class="lg:col-span-8">
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out mb-10">
        <span class="block text-xs tracking-widest uppercase text-accent font-bold mb-2">
          SERVICIOS E INSTALACIONES
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary tracking-tight leading-snug">
          Todo dispuesto para tu tranquilidad y descanso
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 divide-y divide-gray-200/80 border-t border-b border-gray-200/80">
        <!-- 1. Desayuno Incluido -->
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
            <line x1="6" x2="6" y1="2" y2="4"></line>
            <line x1="10" x2="10" y1="2" y2="4"></line>
            <line x1="14" x2="14" y1="2" y2="4"></line>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Desayuno Incluido
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Para comenzar cada mañana sin preocupaciones.
            </p>
          </div>
        </div>

        <!-- 2. Recepción 24 Horas -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4 sm:!border-t-0"
          style="transition-delay: 60ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Recepción 24 Horas
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Atención continua durante toda tu estadía.
            </p>
          </div>
        </div>

        <!-- 3. Pet Friendly -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 120ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="11" cy="4" r="2"></circle>
            <circle cx="18" cy="8" r="2"></circle>
            <circle cx="20" cy="16" r="2"></circle>
            <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Pet Friendly
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Tus mascotas son bienvenidas en nuestras instalaciones.
            </p>
          </div>
        </div>

        <!-- 4. Estacionamiento Privado -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 180ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect width="18" height="18" x="3" y="3"></rect>
            <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Estacionamiento Privado
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Acceso directo y seguro dentro del recinto.
            </p>
          </div>
        </div>

        <!-- 5. WiFi de Alta Velocidad -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 240ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M12 20h.01"></path>
            <path d="M2 8.82a15 15 0 0 1 20 0"></path>
            <path d="M5 12.859a10 10 0 0 1 14 0"></path>
            <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              WiFi de Alta Velocidad
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Conexión gratuita en todas las cabañas y áreas.
            </p>
          </div>
        </div>

        <!-- 6. Terraza Común y Taca Taca -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 300ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Terraza Común y Taca Taca
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Espacios renovados para compartir en familia.
            </p>
          </div>
        </div>

        <!-- 7. Zona de Juegos Infantiles -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 360ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Zona de Juegos Infantiles
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Parque seguro dentro del recinto para los niños.
            </p>
          </div>
        </div>

        <!-- 8. Minimarket 24 Horas -->
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-6 flex items-start gap-4"
          style="transition-delay: 420ms;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M6 2 3 6v14h18V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <div>
            <h3 class="font-bold text-primary text-sm uppercase tracking-wider">
              Minimarket 24 Horas
            </h3>
            <p class="text-sm text-gray-700 leading-relaxed mt-1">
              Venta de snacks y bebidas en recepción.
            </p>
          </div>
        </div>
      </div>

      <!-- Banner de Proyección Institucional -->
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-primary text-white p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center gap-4 mt-10 rounded-none">
        <span class="inline-block bg-accent text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-none shrink-0">
          PRÓXIMAMENTE
        </span>
        <p class="text-sm text-white/95 leading-relaxed">
          Seguimos creciendo junto a ti: estamos construyendo un nuevo salón comedor exclusivo para el servicio de desayuno.
        </p>
      </div>
    </div>
  </div>
</section>
