---
---

<section class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12 max-w-7xl mx-auto">
  <!-- 1. Bloque Superior de Métricas (3 Columnas) -->
  <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200 border-b border-gray-200 pb-12 mb-16">
    <!-- Columna 1 -->
    <div
      class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 text-center"
      style="transition-delay: 0ms;"
    >
      <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
        TRAYECTORIA
      </span>
      <p class="font-serif text-4xl font-bold text-primary mb-2">
        +25
      </p>
      <p class="text-sm text-gray-500">
        Años de tradición familiar en La Serena
      </p>
    </div>

    <!-- Columna 2 -->
    <div
      class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 text-center"
      style="transition-delay: 120ms;"
    >
      <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
        EXCELENCIA
      </span>
      <p class="font-serif text-4xl font-bold text-primary mb-2">
        9,7
      </p>
      <p class="text-sm text-gray-500">
        Calificación sobresaliente en Limpieza
      </p>
    </div>

    <!-- Columna 3 -->
    <div
      class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 text-center"
      style="transition-delay: 240ms;"
    >
      <span class="block text-accent text-xs tracking-widest uppercase font-bold mb-2">
        CAPACIDAD
      </span>
      <p class="font-serif text-4xl font-bold text-primary mb-2">
        21
      </p>
      <p class="text-sm text-gray-500">
        Cabañas totalmente equipadas a pasos del mar
      </p>
    </div>
  </div>

  <!-- 2. Matriz de Servicios y Espacios Comunes (Grid 4x2 Simétrico) -->
  <div>
    <h2 class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-xs tracking-widest uppercase text-center text-gray-400 font-bold mb-8">
      SERVICIOS E INSTALACIONES
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
      <!-- 1. Desayuno Incluido -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 0ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M17 8h1a4 4 0 1 1 0 8h-1"></path>
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"></path>
          <line x1="6" x2="6" y1="2" y2="4"></line>
          <line x1="10" x2="10" y1="2" y2="4"></line>
          <line x1="14" x2="14" y1="2" y2="4"></line>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Desayuno Incluido
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Para comenzar cada mañana sin preocupaciones.
        </p>
      </div>

      <!-- 2. Recepción 24 Horas -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 80ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Recepción 24 Horas
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Atención continua durante toda tu estadía.
        </p>
      </div>

      <!-- 3. Pet Friendly -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 160ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <circle cx="11" cy="4" r="2"></circle>
          <circle cx="18" cy="8" r="2"></circle>
          <circle cx="20" cy="16" r="2"></circle>
          <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Pet Friendly
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Tus mascotas son bienvenidas en nuestras instalaciones.
        </p>
      </div>

      <!-- 4. Estacionamiento Privado -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 240ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <rect width="18" height="18" x="3" y="3"></rect>
          <path d="M9 17V7h4a3 3 0 0 1 0 6H9"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Estacionamiento Privado
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Acceso directo y seguro dentro del recinto.
        </p>
      </div>

      <!-- 5. WiFi de Alta Velocidad -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 80ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M12 20h.01"></path>
          <path d="M2 8.82a15 15 0 0 1 20 0"></path>
          <path d="M5 12.859a10 10 0 0 1 14 0"></path>
          <path d="M8.5 16.429a5 5 0 0 1 7 0"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          WiFi de Alta Velocidad
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Conexión gratuita en todas las cabañas y áreas.
        </p>
      </div>

      <!-- 6. Terraza Común y Taca Taca -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 160ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Terraza Común y Taca Taca
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Espacios renovados para compartir en familia.
        </p>
      </div>

      <!-- 7. Zona de Juegos Infantiles -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 240ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Zona de Juegos Infantiles
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Parque seguro dentro del recinto para los niños.
        </p>
      </div>

      <!-- 8. Minimarket 24 Horas -->
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-6 flex flex-col items-start text-left"
        style="transition-delay: 320ms;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M6 2 3 6v14h18V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <h3 class="font-bold text-primary text-sm uppercase tracking-wider mt-3">
          Minimarket 24 Horas
        </h3>
        <p class="text-xs text-gray-500 mt-1">
          Venta de snacks y bebidas en recepción.
        </p>
      </div>
    </div>

    <!-- 3. Banner de Proyección (Toque Institucional) -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-primary text-white p-6 flex flex-col md:flex-row items-center justify-between mt-8 rounded-none gap-4">
      <div class="flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
        <span class="inline-block bg-accent text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-none shrink-0">
          PRÓXIMAMENTE
        </span>
        <p class="text-sm text-white/95 leading-relaxed">
          Seguimos creciendo junto a ti: estamos construyendo un nuevo salón comedor exclusivo para el servicio de desayuno.
        </p>
      </div>
    </div>
  </div>
</section>
