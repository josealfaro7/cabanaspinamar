---
// Herramienta de desarrollo: solo se monta con `npm run dev` (ver Layout.astro).
// Ajusta el peso de la tipografía de títulos en vivo. El valor elegido se fija
// después en --display-wght dentro de Layout.astro.
---

<div
  id="font-tuner"
  class="fixed left-3 bottom-24 sm:bottom-4 z-[90] w-64 bg-ink text-bone text-sm shadow-2xl p-4 font-sans"
  role="group"
  aria-label="Ajuste de peso de la tipografía de títulos (solo desarrollo)"
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-[11px] uppercase tracking-[0.08em] text-bone/70">Peso títulos · dev</span>
    <button type="button" id="ft-hide" class="text-bone/70 hover:text-bone px-1" aria-label="Ocultar panel">✕</button>
  </div>
  <div class="mt-3 flex items-baseline justify-between">
    <label for="ft-range" class="font-display text-2xl">Cabañas Pinamar</label>
    <output id="ft-value" for="ft-range" class="tabular-nums text-bone/80">420</output>
  </div>
  <input id="ft-range" type="range" min="300" max="650" step="10" value="420" class="mt-3 w-full accent-terracotta" />
  <div class="mt-2 flex justify-between text-[11px] text-bone/60"><span>300 fina</span><span>650 gruesa</span></div>
  <div class="mt-3 flex gap-2">
    <button type="button" id="ft-reset" class="flex-1 h-9 border border-bone/25 hover:border-bone">Restablecer</button>
    <button type="button" id="ft-copy" class="flex-1 h-9 bg-terracotta hover:bg-terracotta-dark">Copiar valor</button>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'pinamar-display-wght';
    const panel = document.getElementById('font-tuner');
    if (!panel) return;
    const DEFAULT = getComputedStyle(document.documentElement).getPropertyValue('--display-wght').trim() || '420';
    const range = document.getElementById('ft-range');
    const out = document.getElementById('ft-value');

    const apply = (v) => {
      document.documentElement.style.setProperty('--display-wght', v);
      range.value = v;
      out.textContent = v;
      try { localStorage.setItem(KEY, v); } catch {}
    };

    let saved = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    apply(saved ?? DEFAULT);

    range.addEventListener('input', () => apply(range.value));
    document.getElementById('ft-reset').addEventListener('click', () => apply(DEFAULT));
    document.getElementById('ft-copy').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      try {
        await navigator.clipboard.writeText(`--display-wght: ${range.value};`);
        btn.textContent = 'Copiado';
      } catch {
        btn.textContent = range.value;
      }
      setTimeout(() => (btn.textContent = 'Copiar valor'), 1500);
    });
    document.getElementById('ft-hide').addEventListener('click', () => panel.remove());
  })();
</script>
