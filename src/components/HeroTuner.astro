---
// Herramienta de desarrollo: solo se monta con `npm run dev` (ver Hero.astro).
// Alterna entre las variantes de portada renderizadas en modo desarrollo.
---

<div
  id="hero-tuner"
  class="fixed left-3 bottom-24 sm:bottom-4 z-[90] w-72 bg-ink text-bone text-sm shadow-2xl p-4 font-sans"
  role="group"
  aria-label="Comparar variantes de portada (solo desarrollo)"
>
  <div class="flex items-center justify-between gap-2">
    <span class="text-[11px] uppercase tracking-[0.08em] text-bone/70">Portada · dev</span>
    <button type="button" id="ht-hide" class="text-bone/70 hover:text-bone px-1" aria-label="Ocultar panel">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <label for="ht-range" class="mt-3 flex items-baseline justify-between">
    <span>Opción <output id="ht-n" class="tabular-nums">1</output></span>
    <output id="ht-name" class="font-display text-lg">Actual</output>
  </label>
  <input id="ht-range" type="range" min="1" max="4" step="1" value="1" class="mt-2 w-full accent-terracotta" />
  <p id="ht-desc" class="mt-1 text-[12px] text-bone/70 min-h-[3.75em]"></p>
  <button type="button" id="ht-copy" class="mt-2 w-full h-9 bg-terracotta hover:bg-terracotta-dark">Copiar elección</button>
</div>

<script is:inline>
  (() => {
    const panel = document.getElementById('hero-tuner');
    if (!panel) return;
    const KEY = 'pinamar-hero-variant';
    const opts = [
      { id: 'actual', name: 'Actual', desc: 'Foto de la entrada a pantalla completa con el título encima.' },
      { id: 'mosaico', name: 'Mosaico', desc: 'Título grande sobre fondo claro y dos fotos verticales escalonadas.' },
      { id: 'panoramica', name: 'Panorámica', desc: 'Título arriba y una banda panorámica aérea con el buscador encima.' },
      { id: 'dividida', name: 'Dividida', desc: 'Título y buscador a la izquierda, foto aérea vertical a la derecha.' },
    ];
    const $ = (id) => document.getElementById(id);
    const range = $('ht-range');
    const apply = (n) => {
      const o = opts[n - 1];
      document.querySelectorAll('[data-hero-variant]').forEach((s) => (s.hidden = s.dataset.heroVariant !== o.id));
      range.value = n;
      $('ht-n').textContent = n;
      $('ht-name').textContent = o.name;
      $('ht-desc').textContent = o.desc;
      try { localStorage.setItem(KEY, String(n)); } catch {}
    };
    let saved = null;
    try { saved = +localStorage.getItem(KEY); } catch {}
    apply(saved >= 1 && saved <= 4 ? saved : 1);
    range.addEventListener('input', () => apply(+range.value));
    $('ht-copy').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const o = opts[+range.value - 1];
      try { await navigator.clipboard.writeText(`Portada: ${o.name} (${o.id})`); btn.textContent = 'Copiado'; } catch { btn.textContent = o.name; }
      setTimeout(() => (btn.textContent = 'Copiar elección'), 1500);
    });
    $('ht-hide').addEventListener('click', () => panel.remove());
  })();
</script>
