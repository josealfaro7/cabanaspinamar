---
import { tiposCabana } from '../data/tipos';
import { cabinEquipment, hotelsyncUrl } from '../data/site';
import Cinta from './cabanas/Cinta.astro';
import Lightbox from './cabanas/Lightbox.astro';

const equipment = `${cabinEquipment.slice(0, -1).join(', ').toLowerCase()} y ${cabinEquipment.at(-1)}`;
---

<section id="cabanas" class="bg-sand pt-16 sm:pt-28 pb-10 sm:pb-16" aria-labelledby="cabanas-title">
  <div class="max-w-page mx-auto px-5 sm:px-10">
    <div class="grid lg:grid-cols-12 gap-4 lg:gap-16 items-end mb-10 sm:mb-14">
      <h2 id="cabanas-title" class="lg:col-span-5 font-display text-3xl sm:text-[2.75rem] leading-[1.15]">Nuestras cabañas</h2>
      <p class="lg:col-span-7 text-lg max-w-[58ch]">
        21 cabañas equipadas, en tres tipos. Todas incluyen {equipment}.
      </p>
    </div>

    <ul class="grid md:grid-cols-3 gap-10 md:gap-6 lg:gap-8">
      {tiposCabana.map((t) => {
        const portada = t.fotos.find((p) => p.id === t.portada) ?? t.fotos[0];
        return (
          <li>
            <article class="group" aria-labelledby={`${t.id}-title`}>
              <button
                type="button"
                data-lb-open={`galeria-${t.id}`}
                data-lb-index="0"
                class="block w-full relative aspect-[4/3] overflow-hidden rounded-[4px] bg-bone shadow-[0_26px_50px_-28px_rgb(31_43_42/0.55)]"
                aria-label={`Ver las ${t.fotos.length} fotos de ${t.nombre}`}
              >
                <img
                  src={portada.src}
                  srcset={`${portada.srcSmall} 800w, ${portada.src} 1600w`}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt={portada.alt}
                  width="1600"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
                />
                <span class="absolute right-3 bottom-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-ctl bg-ink/70 text-bone text-[13px] font-medium backdrop-blur">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="1" /><circle cx="9" cy="10" r="1.5" /><path d="m21 16-5-5-8 8" /></svg>
                  {t.fotos.length} fotos
                </span>
              </button>
              <h3 id={`${t.id}-title`} class="mt-5 font-display text-2xl">{t.nombre}</h3>
              {t.detalle && <p class="mt-1 text-stone">{t.detalle}</p>}
              {t.descripcion && <p class="mt-2 max-w-[44ch]">{t.descripcion}</p>}
              <a
                href={hotelsyncUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-2 min-h-[44px] text-terracotta font-medium hover:text-terracotta-dark"
              >
                Ver disponibilidad
                <svg aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </article>
            <Lightbox id={`galeria-${t.id}`} fotos={t.fotos} />
          </li>
        );
      })}
    </ul>

    <h3 class="mt-16 sm:mt-24 font-display text-2xl sm:text-3xl">Recorre el complejo</h3>
  </div>

  <div class="mt-6 sm:mt-8">
    <Cinta />
  </div>
</section>
