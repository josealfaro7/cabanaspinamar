---
import { fotos, resumenCabanas } from '../../data/recorrido';
import { cabinEquipment } from '../../data/site';
import GuestPicker from './GuestPicker.astro';
import Lightbox from './Lightbox.astro';

const interiores = fotos.filter((p) => ['dormitorios', 'cocina-living', 'banos'].includes(p.espacio));
const exteriores = fotos.filter((p) => ['terrazas', 'complejo'].includes(p.espacio));
const filas = [
  { fotos: interiores, dir: 'izq', dur: 90 },
  { fotos: exteriores, dir: 'der', dur: 75 },
];
const datos = [
  { v: String(resumenCabanas.cantidad), l: 'cabañas equipadas' },
  { v: '1 a 7', l: 'personas por cabaña' },
  { v: '28 a 75 m²', l: 'de superficie' },
];
---

<section id="cabanas" class="bg-sand py-16 sm:py-28 overflow-hidden" aria-labelledby="cabanas-title" data-cinta>
  <div class="max-w-page mx-auto px-5 sm:px-10 text-center">
    <h2 id="cabanas-title" class="font-display text-3xl sm:text-[2.75rem] leading-[1.15]">Las cabañas</h2>
    <p class="mt-4 text-lg max-w-[56ch] mx-auto">
      Todas tienen {cabinEquipment.slice(0, -1).join(', ').toLowerCase()} y {cabinEquipment.at(-1)}. Tú nos dices cuántos
      vienen; nosotros te asignamos la cabaña.
    </p>
  </div>

  <div class="mt-10 sm:mt-14 space-y-3 sm:space-y-4" role="region" aria-label="Fotos de las cabañas y el complejo">
    {filas.map((fila) => (
      <div class="fila relative">
        <ul class:list={['track flex w-max gap-3 sm:gap-4', fila.dir === 'der' && 'track-der']} style={`--dur:${fila.dur}s`}>
          {[0, 1].map((copia) =>
            fila.fotos.map((p) => (
              <li class="shrink-0" aria-hidden={copia === 1 ? 'true' : undefined}>
                <button
                  type="button"
                  data-lb-open="galeria-cinta"
                  data-lb-src={p.src}
                  tabindex={copia === 1 ? -1 : undefined}
                  class="group block relative h-[200px] sm:h-[280px] lg:h-[320px] aspect-[16/10] overflow-hidden rounded-[4px] bg-bone"
                  aria-label={`Ampliar foto: ${p.caption}`}
                >
                  <img
                    src={p.srcSmall}
                    srcset={`${p.srcSmall} 800w, ${p.src} 1600w`}
                    sizes="(min-width: 1024px) 520px, (min-width: 640px) 450px, 320px"
                    alt={copia === 1 ? '' : p.alt}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  />
                  <span class="absolute left-3 bottom-3 px-2.5 py-1 rounded-ctl bg-bone/90 text-ink text-[13px] font-medium opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 transition">
                    {p.caption}
                  </span>
                </button>
              </li>
            ))
          )}
        </ul>
      </div>
    ))}
    <div class="max-w-page mx-auto px-5 sm:px-10 flex justify-end">
      <button type="button" data-cinta-toggle class="inline-flex items-center gap-2 h-11 px-3 text-sm text-stone hover:text-ink">
        <svg data-icon-pause aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6v12M15 6v12" /></svg>
        <svg data-icon-play aria-hidden="true" viewBox="0 0 24 24" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 5l11 7-11 7Z" /></svg>
        <span data-label>Pausar fotos</span>
      </button>
    </div>
  </div>

  <div class="max-w-page mx-auto px-5 sm:px-10 mt-8 sm:mt-12">
    <div class="max-w-[46rem] mx-auto bg-bone shadow-[0_18px_40px_-20px_rgb(31_43_42/0.35)] p-5 sm:p-8">
      <dl class="grid grid-cols-3 text-center border-b border-ink/10 pb-5 mb-6">
        {datos.map((d, n) => (
          <div class:list={[n > 0 && 'border-l border-ink/10']}>
            <dt class="sr-only">{d.l}</dt>
            <dd class="font-display text-xl sm:text-3xl tabular-nums whitespace-nowrap">{d.v}</dd>
            <dd class="text-[13px] sm:text-sm text-stone mt-0.5">{d.l}</dd>
          </div>
        ))}
      </dl>
      <GuestPicker />
    </div>
  </div>
  <Lightbox id="galeria-cinta" fotos={[...interiores, ...exteriores]} />
</section>

<style>
  .track {
    animation: cinta var(--dur) linear infinite;
  }
  .track-der {
    animation-direction: reverse;
  }
  .fila:hover .track,
  .fila:focus-within .track,
  [data-cinta].is-paused .track {
    animation-play-state: paused;
  }
  @keyframes cinta {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }
  @media (min-width: 640px) {
    @keyframes cinta {
      to {
        transform: translateX(calc(-50% - 0.5rem));
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .fila {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: 1.25rem;
    }
    .fila li {
      scroll-snap-align: start;
    }
    .fila li[aria-hidden='true'] {
      display: none;
    }
    [data-cinta-toggle] {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cinta]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-cinta-toggle]')!;
    btn.addEventListener('click', () => {
      const p = root.classList.toggle('is-paused');
      btn.querySelector('[data-label]')!.textContent = p ? 'Reanudar fotos' : 'Pausar fotos';
      btn.querySelector('[data-icon-pause]')!.classList.toggle('hidden', p);
      btn.querySelector('[data-icon-play]')!.classList.toggle('hidden', !p);
    });
  });
</script>
