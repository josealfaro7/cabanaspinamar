---
interface Props {
  actual: number;
}
const { actual } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nombres = ['Recorrido', 'Por espacios', 'Cinta continua'];
---

<nav aria-label="Propuestas de la sección Cabañas" class="fixed z-[60] left-1/2 -translate-x-1/2 top-[76px] sm:top-[88px] flex items-center gap-1 p-1 rounded-full bg-ink/90 text-bone text-sm shadow-lg backdrop-blur">
  {nombres.map((n, i) => (
    <a
      href={`${base}/propuestas-cabanas/${i + 1}/#cabanas`}
      aria-current={actual === i + 1 ? 'page' : undefined}
      class:list={['px-3 sm:px-4 h-9 inline-flex items-center rounded-full whitespace-nowrap', actual === i + 1 ? 'bg-bone text-ink font-medium' : 'hover:bg-bone/15']}
    >
      <span class="sm:hidden">{i + 1}</span>
      <span class="hidden sm:inline">{i + 1}. {n}</span>
    </a>
  ))}
</nav>
