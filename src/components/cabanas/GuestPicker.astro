---
import { HOTELSYNC_ENGINE, HOTELSYNC_CODE, whatsappUrl } from '../../data/site';

interface Props {
  tone?: 'light' | 'dark';
  compact?: boolean;
}
const { tone = 'light', compact = false } = Astro.props;
const dark = tone === 'dark';
const options = [1, 2, 3, 4, 5, 6, 7];
---

<form action={HOTELSYNC_ENGINE} method="get" target="_blank" data-hide-mobile-bar class="w-full">
  <input type="hidden" name="engine_code" value={HOTELSYNC_CODE} />
  <fieldset>
    <legend class:list={['text-[13px] font-semibold uppercase tracking-[0.08em]', dark ? 'text-bone/75' : 'text-stone']}>
      ¿Cuántas personas vienen?
    </legend>
    <div class="mt-2 grid grid-cols-7 gap-1.5">
      {options.map((n) => (
        <label class="relative">
          <input type="radio" name="adults" value={n} checked={n === 2} class="peer sr-only" />
          <span
            class:list={[
              'flex items-center justify-center h-12 rounded-ctl border cursor-pointer text-lg tabular-nums transition-colors peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-terracotta',
              dark
                ? 'border-bone/30 text-bone hover:border-bone/70 peer-checked:bg-bone peer-checked:text-ink peer-checked:border-bone'
                : 'border-ink/20 bg-bone hover:border-ink/50 peer-checked:bg-ink peer-checked:text-bone peer-checked:border-ink',
            ]}
          >
            {n}
          </span>
        </label>
      ))}
    </div>
  </fieldset>
  <input type="hidden" name="children" value="0" />
  <input type="hidden" name="currency" value="CLP" />
  <button
    type="submit"
    class="mt-3 w-full h-12 rounded-ctl bg-terracotta hover:bg-terracotta-dark text-white font-medium transition-colors"
  >
    Ver disponibilidad y tarifa
  </button>
  {!compact && (
    <p class:list={['mt-3 text-sm leading-relaxed', dark ? 'text-bone/75' : 'text-stone']}>
      Cuenta a todos desde los 5 años; los menores de 5 no pagan. Recepción te asigna la cabaña según cuántos vengan.
      <a
        href={whatsappUrl('Hola, quiero consultar disponibilidad en Cabañas Pinamar.')}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['inline-block py-2.5 underline underline-offset-4', dark ? 'text-bone decoration-bone/40 hover:decoration-bone' : 'text-ink decoration-ink/30 hover:decoration-ink']}
      >
        ¿Dudas? Escríbenos por WhatsApp
      </a>
    </p>
  )}
</form>
