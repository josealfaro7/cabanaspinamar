---
import type { Foto } from '../../data/recorrido';

interface Props {
  id: string;
  fotos: Foto[];
}
const { id, fotos } = Astro.props;
const data = JSON.stringify(fotos.map((p) => ({ src: p.src, alt: p.alt, caption: p.caption, espacio: p.espacio })));
---

<dialog
  id={id}
  data-lightbox={data}
  class="lightbox m-0 p-0 w-screen h-[100dvh] max-w-none max-h-none bg-ink text-bone"
  aria-label="Galería de fotos"
>
  <div class="h-full flex flex-col">
    <div class="flex items-center justify-between px-4 sm:px-8 h-16 shrink-0">
      <p class="text-sm text-bone/75 tabular-nums" data-lb-count></p>
      <button type="button" data-lb-close class="w-11 h-11 -mr-2 grid place-items-center rounded-ctl hover:bg-bone/10" aria-label="Cerrar galería">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <figure class="relative flex-1 min-h-0 flex flex-col items-center justify-center px-4 sm:px-20">
      <img data-lb-img alt="" class="max-h-full max-w-full object-contain rounded-[4px]" />
      <figcaption data-lb-caption class="mt-4 text-bone/85 text-center"></figcaption>
      <button type="button" data-lb-prev class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 grid place-items-center rounded-full bg-ink/60 hover:bg-bone/15" aria-label="Foto anterior">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <button type="button" data-lb-next class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 grid place-items-center rounded-full bg-ink/60 hover:bg-bone/15" aria-label="Foto siguiente">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </figure>
    <div class="h-8 shrink-0"></div>
  </div>
</dialog>

<style>
  .lightbox::backdrop {
    background: rgb(31 43 42 / 0.9);
  }
</style>

<script>
  type Item = { src: string; alt: string; caption: string; espacio: string };

  document.querySelectorAll<HTMLDialogElement>('dialog[data-lightbox]').forEach((dlg) => {
    const items: Item[] = JSON.parse(dlg.dataset.lightbox || '[]');
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    let i = 0;

    const show = (n: number) => {
      i = (n + items.length) % items.length;
      img.src = items[i].src;
      img.alt = items[i].alt;
      cap.textContent = items[i].caption;
      count.textContent = `${i + 1} de ${items.length}`;
    };

    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });

    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });

    document.querySelectorAll<HTMLElement>(`[data-lb-open="${dlg.id}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        const start = btn.dataset.lbSrc ? items.findIndex((it) => it.src === btn.dataset.lbSrc) : Number(btn.dataset.lbIndex || 0);
        show(Math.max(0, start));
        dlg.showModal();
      });
    });
  });
</script>
