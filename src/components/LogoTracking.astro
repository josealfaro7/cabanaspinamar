---
import { asset } from '../data/site';

const presets = [0, 0.04, 0.08, 0.12, 0.16];
const inicial = 0.04;
---

<div
  data-logo-tracking
  data-inicial={inicial}
  class="fixed z-[60] left-1/2 -translate-x-1/2 bottom-20 sm:bottom-6 w-[min(94vw,36rem)] rounded-[4px] bg-bone text-ink shadow-[0_18px_50px_-12px_rgb(31_43_42/0.45)] border border-ink/10 p-3 sm:p-4"
  role="group"
  aria-label="Comparar el espaciado entre letras del logotipo"
>
  <div class="flex items-center gap-3 sm:gap-4">
    <img src={asset('/logocabanas.webp')} alt="Logo de Cabañas Pinamar" width="64" height="64" class="w-14 h-14 sm:w-16 sm:h-16 shrink-0" />
    <p class="font-logo flex-1 min-w-0 text-[1.35rem] sm:text-[1.75rem] leading-none whitespace-nowrap overflow-hidden">Cabañas Pinamar</p>
  </div>

  <div class="mt-3 border-t border-ink/10 pt-3">
    <label class="flex items-center justify-between gap-3 text-sm" for="logo-tracking">
      <span class="text-[13px] font-semibold uppercase tracking-[0.08em] text-stone">Espacio entre letras</span>
      <output data-valor for="logo-tracking" class="tabular-nums font-medium">0,04 em</output>
    </label>
    <input id="logo-tracking" data-range type="range" min="0" max="0.25" step="0.005" value={inicial} class="mt-2 w-full h-11 accent-terracotta cursor-pointer" />
    <div class="mt-1 flex flex-wrap gap-1.5" role="group" aria-label="Valores para comparar">
      {presets.map((p) => (
        <button
          type="button"
          data-preset={p}
          class="h-9 px-3 rounded-ctl border border-ink/15 text-sm tabular-nums hover:border-ink/50 aria-pressed:bg-ink aria-pressed:text-bone aria-pressed:border-ink"
          aria-pressed={p === inicial ? 'true' : 'false'}
        >
          {String(p).replace('.', ',')}
        </button>
      ))}
    </div>
  </div>
</div>

<style is:global>
  html[data-logo-tracking] .font-logo {
    letter-spacing: var(--lt) !important;
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-logo-tracking]');
  if (box) {
    const range = box.querySelector<HTMLInputElement>('[data-range]')!;
    const valor = box.querySelector<HTMLOutputElement>('[data-valor]')!;
    const presets = [...box.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    const root = document.documentElement;
    const desdeUrl = parseFloat(new URLSearchParams(location.search).get('espaciado') || '');

    const aplicar = (v: number) => {
      const t = Math.round(v * 1000) / 1000;
      root.dataset.logoTracking = '';
      root.style.setProperty('--lt', `${t}em`);
      range.value = String(t);
      valor.textContent = `${String(t).replace('.', ',')} em`;
      presets.forEach((b) => b.setAttribute('aria-pressed', Math.abs(Number(b.dataset.preset) - t) < 0.001 ? 'true' : 'false'));
      const url = new URL(location.href);
      url.searchParams.set('espaciado', String(t));
      history.replaceState(null, '', url);
    };

    range.addEventListener('input', () => aplicar(Number(range.value)));
    presets.forEach((b) => b.addEventListener('click', () => aplicar(Number(b.dataset.preset))));
    aplicar(Number.isFinite(desdeUrl) ? desdeUrl : Number(box.dataset.inicial));
  }
</script>
