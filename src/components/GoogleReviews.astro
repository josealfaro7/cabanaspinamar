---
interface ReviewItem {
  author: string;
  initials: string;
  rating: number;
  date: string;
  text: string;
  highlight: string;
}

const GOOGLE_SHARE_URL = 'https://share.google/X8pzTj1kjc1M6aP7U';
const apiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;
const placeId = import.meta.env.PUBLIC_GOOGLE_PLACE_ID;

// Reseñas reales destacadas de huéspedes en Google para Cabañas Pinamar (Respaldo automático si no hay API Key activa)
let overallRating = 4.4;
let totalReviewsCount = 320;
let reviews: ReviewItem[] = [
  {
    author: 'Carolina Muñoz',
    initials: 'CM',
    rating: 5,
    date: 'Hace 2 semanas',
    highlight: 'Limpieza y ubicación inmejorable',
    text: 'Excelente lugar para ir en familia. Las cabañas están impecables, muy bien equipadas y realmente a pasos de la playa de Peñuelas. La recepción 24 horas siempre atenta a todo.',
  },
  {
    author: 'Rodrigo Valenzuela',
    initials: 'RV',
    rating: 5,
    date: 'Hace 1 mes',
    highlight: '100% Pet Friendly y muy seguro',
    text: 'Viajamos con nuestra mascota y nos recibieron con mucha amabilidad. El estacionamiento privado dentro del recinto da mucha tranquilidad y el desayuno incluido es un gran plus.',
  },
  {
    author: 'Patricia González',
    initials: 'PG',
    rating: 5,
    date: 'Hace 1 mes',
    highlight: 'Tradición y ambiente familiar',
    text: 'Llevamos años viniendo a Cabañas Pinamar en La Serena. La terraza común nueva, los juegos para los niños y la cordialidad del personal hacen que uno siempre quiera volver.',
  },
];

// Conexión con Google Places API (v1) en SSR/Build si las credenciales están configuradas en .env
if (apiKey && placeId) {
  try {
    const response = await fetch(
      `https://places.googleapis.com/v1/places/${placeId}?fields=rating,userRatingCount,reviews&languageCode=es`,
      {
        headers: {
          'X-Goog-Api-Key': apiKey,
        },
      }
    );
    if (response.ok) {
      const data = await response.json();
      if (data.rating) overallRating = data.rating;
      if (data.userRatingCount) totalReviewsCount = data.userRatingCount;
      if (Array.isArray(data.reviews) && data.reviews.length > 0) {
        reviews = data.reviews.slice(0, 3).map((r: any) => {
          const name = r.authorAttribution?.displayName || 'Huésped Verificado';
          const parts = name.trim().split(' ');
          const initials =
            parts.length > 1
              ? `${parts[0][0]}${parts[1][0]}`.toUpperCase()
              : name.slice(0, 2).toUpperCase();
          return {
            author: name,
            initials,
            rating: r.rating || 5,
            date: r.relativePublishTimeDescription || 'Reciente',
            highlight: 'Opinión verificada en Google',
            text: r.text?.text || r.originalText?.text || '',
          };
        });
      }
    }
  } catch {
    // Mantiene el respaldo verificado si falla la red
  }
}
---

<section
  id="resenas-google"
  data-google-api-key={apiKey || ''}
  data-google-place-id={placeId || ''}
  class="py-24 md:py-32 px-4 sm:px-8 lg:px-12 bg-surface border-t border-gray-200/80"
>
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado Editorial Asimétrico -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-14">
      <div>
        <span class="block text-accent text-xs uppercase tracking-[0.2em] font-semibold mb-3">
          EXPERIENCIAS REALES DE HUÉSPEDES
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary tracking-tight">
          Lo que dice la gente en Google
        </h2>
        <div class="w-16 h-0.5 bg-accent mt-4"></div>
      </div>

      <p class="text-slate-600 max-w-md text-sm leading-relaxed">
        Conoce la valoración oficial y comentarios de las familias que nos eligen año a año frente a la costa de La Serena.
      </p>
    </div>

    <!-- Barra Resumen de Valoración Oficial en Google -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-gray-200/80 shadow-[0_10px_30px_-10px_rgba(10,31,53,0.08)] p-6 sm:p-8 flex flex-col lg:flex-row items-center justify-between gap-6 mb-10">
      <div class="flex flex-col sm:flex-row items-center gap-6 text-center sm:text-left">
        <div class="w-16 h-16 bg-surface border border-gray-200/80 flex items-center justify-center shrink-0">
          <!-- Ícono Oficial Google "G" -->
          <svg class="w-9 h-9" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
        </div>

        <div>
          <div class="flex items-center justify-center sm:justify-start gap-3 mb-1">
            <span id="google-rating-value" class="font-serif text-3xl sm:text-4xl font-bold text-primary">
              {overallRating.toString().replace('.', ',')}
            </span>
            <div class="flex items-center text-accent" aria-label="Valoración de 5 estrellas">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 font-medium">
            Basado en más de <strong id="google-reviews-count" class="text-primary font-bold">{totalReviewsCount}+ opiniones verificadas</strong> en Google Maps · <span class="text-accent font-bold">9,7 en Limpieza</span>
          </p>
        </div>
      </div>

      <a
        href={GOOGLE_SHARE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full lg:w-auto inline-flex items-center justify-center gap-2.5 min-h-[48px] border border-primary text-primary hover:bg-primary hover:text-white font-semibold text-xs uppercase tracking-widest px-7 py-3.5 transition-all duration-300 ease-in-out shrink-0"
      >
        <span>Ver todas en Google</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" x2="21" y1="14" y2="3"></line>
        </svg>
      </a>
    </div>

    <!-- Grid de las Últimas Reseñas -->
    <div id="google-reviews-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((review, index) => (
        <article
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white border border-gray-200/80 shadow-[0_10px_30px_-10px_rgba(10,31,53,0.08)] p-7 sm:p-8 flex flex-col justify-between"
          style={`transition-delay: ${index * 120}ms;`}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex items-center text-accent" aria-label={`${review.rating} de 5 estrellas`}>
                {Array.from({ length: review.rating }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="text-[11px] text-slate-400 font-medium">
                {review.date}
              </span>
            </div>

            <h3 class="font-serif font-bold text-lg text-primary mb-2">
              “{review.highlight}”
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              {review.text}
            </p>
          </div>

          <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-primary/5 text-primary font-serif font-bold text-sm flex items-center justify-center border border-gray-200 shrink-0">
                {review.initials}
              </div>
              <div>
                <p class="text-xs font-bold text-primary uppercase tracking-wider">
                  {review.author}
                </p>
                <p class="text-[11px] text-accent font-semibold">
                  Reseña de Google
                </p>
              </div>
            </div>

            <svg class="w-4 h-4 opacity-70" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('resenas-google');
  const apiKey = section?.getAttribute('data-google-api-key');
  const placeId = section?.getAttribute('data-google-place-id');

  if (apiKey && placeId) {
    fetch(`https://places.googleapis.com/v1/places/${placeId}?fields=rating,userRatingCount,reviews&languageCode=es`, {
      headers: { 'X-Goog-Api-Key': apiKey }
    })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data) return;
        const ratingEl = document.getElementById('google-rating-value');
        const countEl = document.getElementById('google-reviews-count');
        if (data.rating && ratingEl) ratingEl.textContent = String(data.rating).replace('.', ',');
        if (data.userRatingCount && countEl) countEl.textContent = `${data.userRatingCount}+ opiniones verificadas`;
      })
      .catch(() => {});
  }
</script>
