---

<section class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12 bg-surface border-t border-gray-200">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado y Texto Centrado sin cajas grises -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-16">
      <p class="text-xs uppercase tracking-widest text-accent font-bold mb-3">
        ENTORNO COSTERA
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary mb-6">
        Ubicación Privilegiada
      </h2>
      <p class="font-serif italic text-xl sm:text-2xl text-primary/80">
        A 5 minutos a pie de la playa de Peñuelas
      </p>
    </div>

    <!-- Tres Columnas Simples con las Distancias -->
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200 border-t border-b border-gray-200">
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 sm:p-12 text-center"
        style="transition-delay: 0ms;"
      >
        <span class="block text-xs uppercase tracking-widest text-primary/60 font-bold mb-2">
          Faro de La Serena
        </span>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary">
          4,2 km
        </p>
      </div>

      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 sm:p-12 text-center"
        style="transition-delay: 120ms;"
      >
        <span class="block text-xs uppercase tracking-widest text-primary/60 font-bold mb-2">
          Estadio La Portada
        </span>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary">
          5,5 km
        </p>
      </div>

      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out p-8 sm:p-12 text-center"
        style="transition-delay: 240ms;"
      >
        <span class="block text-xs uppercase tracking-widest text-primary/60 font-bold mb-2">
          Aeropuerto La Florida
        </span>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary">
          10 km
        </p>
      </div>
    </div>
  </div>
</section>
