---

<section class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 bg-surface border-t border-gray-200/80">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <!-- Columna Izquierda Editorial (5 Columnas) -->
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out lg:col-span-5">
      <p class="text-xs uppercase tracking-widest text-accent font-bold mb-3">
        ENTORNO COSTERA · LA SERENA
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-primary tracking-tight leading-snug mb-6">
        Ubicación Privilegiada
      </h2>
      <p class="font-serif italic text-xl sm:text-2xl text-primary/85 leading-snug mb-4">
        A 5 minutos a pie de la playa de Peñuelas
      </p>
      <p class="text-gray-700 leading-relaxed text-base">
        Ubicados en Avenida Pacífico 5020, conectamos la tranquilidad del borde costero con los principales hitos de La Serena y Coquimbo.
      </p>
    </div>

    <!-- Columna Derecha: Lista Abierta de Distancias separada por líneas sutiles divide-y -->
    <div class="lg:col-span-7 divide-y divide-gray-200/80 border-t border-b border-gray-200/80">
      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-7 flex items-center justify-between gap-4"
        style="transition-delay: 0ms;"
      >
        <div>
          <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-1">
            PATRIMONIO COSTERO
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-primary">
            Faro de La Serena
          </h3>
        </div>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary shrink-0">
          4,2 km
        </p>
      </div>

      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-7 flex items-center justify-between gap-4"
        style="transition-delay: 100ms;"
      >
        <div>
          <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-1">
            CENTRO Y DEPORTES
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-primary">
            Estadio La Portada
          </h3>
        </div>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary shrink-0">
          5,5 km
        </p>
      </div>

      <div
        class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out py-7 flex items-center justify-between gap-4"
        style="transition-delay: 200ms;"
      >
        <div>
          <span class="block text-xs uppercase tracking-widest text-accent font-bold mb-1">
            CONECTIVIDAD AÉREA
          </span>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-primary">
            Aeropuerto La Florida
          </h3>
        </div>
        <p class="font-serif text-2xl sm:text-3xl font-bold text-primary shrink-0">
          10 km
        </p>
      </div>
    </div>
  </div>
</section>
