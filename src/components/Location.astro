---
import { location, contact } from '../data/site';
---

<section id="ubicacion" class="bg-sand py-16 sm:py-28" aria-labelledby="ubicacion-title">
  <div class="max-w-page mx-auto px-5 sm:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="ubicacion-title" class="font-display text-3xl sm:text-[2.75rem] leading-[1.15]">Dónde estamos</h2>
      <p class="mt-4 text-lg">{contact.address}.</p>
      <p class="text-stone">A 5 minutos a pie de la playa de Peñuelas.</p>

      <h3 class="mt-10 text-[13px] font-semibold uppercase tracking-[0.08em] text-stone">En auto desde</h3>
      <ul class="mt-3 border-t border-ink/10">
        {location.routes.map((r) => (
          <li class="flex justify-between gap-4 py-3.5 border-b border-ink/10">
            <span>{r.from}</span>
            <span class="text-stone tabular-nums whitespace-nowrap">{r.distance} · {r.time}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={location.googleMaps}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-12 px-6 rounded-ctl bg-ink hover:bg-ink/90 text-bone font-medium transition-colors"
        >
          Abrir en Google Maps
        </a>
        <a
          href={location.waze}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center h-12 px-6 rounded-ctl border border-ink/25 hover:border-ink font-medium transition-colors"
        >
          Abrir en Waze
        </a>
      </div>
    </div>

    <div class="lg:col-span-7 min-h-[22rem] lg:min-h-0 bg-bone">
      <iframe
        src={location.mapEmbed}
        title="Mapa: Cabañas Pinamar, Avenida Pacífico 5020, La Serena"
        class="w-full h-full min-h-[22rem] border-0 grayscale-[35%]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
