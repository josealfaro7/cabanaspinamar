---

<section class="py-20 sm:py-28 px-4 sm:px-8 lg:px-12 bg-transparent">
  <div class="max-w-7xl mx-auto">
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block bg-white text-pinamar-navy text-xs uppercase tracking-widest font-bold px-3.5 py-1 mb-3 border border-amber-900/10 shadow-sm">
        ENTORNO COSTERO · LA SERENA
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy mb-4">
        Ubicación <span class="italic font-normal text-sunset-5">Privilegiada</span>
      </h2>
      <!-- Línea Decorativa con el Degradado Vivo del Logo al 100% de Saturación -->
      <div class="w-24 h-1 mx-auto bg-logo-vivid-line bg-gradient-to-r from-[#f9c116] to-[#e76a14] mb-5"></div>
      <p class="font-serif text-xl sm:text-2xl text-pinamar-navy">
        A <span class="italic text-sunset-5">5 minutos a pie</span> de la playa de Peñuelas
      </p>
    </div>

    <!-- Contenedor Blanco Puro Sólido (bg-white) con Borde Fino border-amber-900/10 y Sombra Suave -->
    <div class="bg-white p-2.5 shadow-md border border-amber-900/10">
      <div class="border-2 border-dotted border-[#0A2246]/25 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-amber-900/10 bg-white">
        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-12 text-center"
          style="transition-delay: 0ms;"
        >
          <span class="block text-xs uppercase tracking-widest text-sunset-5 font-bold mb-2">
            Faro de La Serena
          </span>
          <p class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy">
            4,2 km
          </p>
        </div>

        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-12 text-center"
          style="transition-delay: 120ms;"
        >
          <span class="block text-xs uppercase tracking-widest text-sunset-5 font-bold mb-2">
            Estadio La Portada
          </span>
          <p class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy">
            5,5 km
          </p>
        </div>

        <div
          class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white p-8 sm:p-12 text-center"
          style="transition-delay: 240ms;"
        >
          <span class="block text-xs uppercase tracking-widest text-sunset-5 font-bold mb-2">
            Aeropuerto La Florida
          </span>
          <p class="font-serif text-3xl sm:text-4xl font-bold text-pinamar-navy">
            10 km
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
