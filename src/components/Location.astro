---
const LAT = -29.938014;
const LNG = -71.282414;
const DEST_QUERY = encodeURIComponent('Cabañas Pinamar, Av. Pacífico 5020, La Serena, Chile');

const MAP_2D_URL = `https://maps.google.com/maps?q=${DEST_QUERY}&t=m&z=16&output=embed&hl=es`;
const MAP_SAT_URL = `https://maps.google.com/maps?q=${DEST_QUERY}&t=k&z=17&output=embed&hl=es`;
const STREET_VIEW_URL = `https://maps.google.com/maps?layer=c&cbll=${LAT},${LNG}&cbp=12,110,0,0,5&output=svembed&hl=es`;

const GOOGLE_MAPS_DIR_URL = `https://www.google.com/maps/dir/?api=1&destination=${LAT},${LNG}`;
const WAZE_URL = `https://waze.com/ul?ll=${LAT},${LNG}&navigate=yes`;
const FULL_STREET_VIEW_URL = `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${LAT},${LNG}`;

const routes = [
  {
    id: 'faro',
    name: 'Faro de La Serena',
    distance: '4,2 km',
    time: '6 min en auto',
    originQuery: 'Faro Monumental de La Serena, Chile',
  },
  {
    id: 'terminal',
    name: 'Terminal de Buses',
    distance: '4,8 km',
    time: '10 min en auto',
    originQuery: 'Terminal de Buses La Serena, Amunátegui, La Serena, Chile',
  },
  {
    id: 'estadio',
    name: 'Estadio La Portada',
    distance: '5,5 km',
    time: '12 min en auto',
    originQuery: 'Estadio La Portada, La Serena, Chile',
  },
  {
    id: 'aeropuerto',
    name: 'Aeropuerto La Florida',
    distance: '10 km',
    time: '18 min en auto',
    originQuery: 'Aeropuerto La Florida, La Serena, Chile',
  },
];
---

<section id="como-llegar" class="py-16 sm:py-24 px-4 sm:px-8 lg:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out text-center max-w-3xl mx-auto mb-14">
      <span class="inline-block rounded-full bg-white text-[#E86F2C] text-xs uppercase tracking-widest font-bold px-4 py-1.5 mb-3 border border-[#0A2246]/10 shadow-sm">
        ENTORNO COSTERO · AV. PACÍFICO 5020, LA SERENA
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#0A2246] mb-3">
        Ubicación Privilegiada y <span class="italic font-normal text-[#E86F2C]">Cómo Llegar</span>
      </h2>
      <p class="font-serif text-xl sm:text-2xl text-[#0A2246]">
        A <span class="italic text-[#E86F2C]">5 minutos a pie</span> de la playa de Peñuelas
      </p>
    </div>

    <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-700 ease-out bg-white rounded-3xl shadow-[0_18px_45px_-12px_rgba(10,34,70,0.10)] border border-[#0A2246]/10 overflow-hidden">
      <!-- Barra Superior: Conmutador Mapa 2D / Street View 360° / Satélite -->
      <div class="p-4 sm:p-6 border-b border-[#0A2246]/10 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 bg-[#FAF6F0]">
        <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Modo de visualización del mapa">
          <button
            type="button"
            data-map-mode="map2d"
            data-map-src={MAP_2D_URL}
            data-map-label="Mostrando: Mapa interactivo de Av. Pacífico 5020 y Playa de Peñuelas"
            class="location-view-btn rounded-full bg-[#0A2246] text-white border border-[#0A2246] px-5 py-2.5 text-xs uppercase tracking-widest font-bold transition-all duration-200 inline-flex items-center gap-2 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#F9C600]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line>
              <line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
            <span>Mapa 2D</span>
          </button>

          <button
            type="button"
            data-map-mode="streetview"
            data-map-src={STREET_VIEW_URL}
            data-map-label="Mostrando: Street View 360° frente a Cabañas Pinamar (Av. Pacífico 5020)"
            class="location-view-btn rounded-full bg-white text-[#0A2246] hover:bg-[#0A2246]/5 border border-[#0A2246]/15 px-5 py-2.5 text-xs uppercase tracking-widest font-bold transition-all duration-200 inline-flex items-center gap-2 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#E86F2C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="5" r="3"></circle>
              <path d="M12 8v8"></path>
              <path d="M9 12h6"></path>
              <path d="M5 19c1.5-2 4.2-3 7-3s5.5 1 7 3"></path>
            </svg>
            <span>Street View 360°</span>
          </button>

          <button
            type="button"
            data-map-mode="satellite"
            data-map-src={MAP_SAT_URL}
            data-map-label="Mostrando: Vista Satelital Costera (Cercanía real al mar)"
            class="location-view-btn rounded-full bg-white text-[#0A2246] hover:bg-[#0A2246]/5 border border-[#0A2246]/15 px-5 py-2.5 text-xs uppercase tracking-widest font-bold transition-all duration-200 inline-flex items-center gap-2 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#E86F2C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Vista Satélite</span>
          </button>
        </div>

        <p id="location-active-label" class="text-xs font-semibold text-[#0A2246]/75">
          Mostrando: Mapa interactivo de Av. Pacífico 5020 y Playa de Peñuelas
        </p>
      </div>

      <!-- Visor Interactivo Embebido -->
      <div class="relative w-full h-[380px] sm:h-[450px] bg-[#FAF6F0] border-b border-[#0A2246]/10">
        <iframe
          id="pinamar-map-iframe"
          src={MAP_2D_URL}
          title="Mapa y Street View de Cabañas Pinamar en Av. Pacífico 5020, La Serena"
          class="w-full h-full border-0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <!-- Calculador de Rutas Rápidas -->
      <div class="p-6 sm:p-8 border-b border-[#0A2246]/10 bg-white">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5">
          <div>
            <span class="text-[11px] uppercase tracking-widest font-bold text-[#E86F2C] block">
              CALCULADOR DE RUTA EN UN CLIC
            </span>
            <h3 class="font-serif text-xl font-bold text-[#0A2246]">
              ¿Desde dónde vienes? Haz clic en un punto para trazar cómo llegar:
            </h3>
          </div>
          <span class="text-xs text-[#0A2246]/60 font-medium">
            Destino fijo: Av. Pacífico 5020, La Serena
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {routes.map((route) => {
            const routeEmbedUrl = `https://maps.google.com/maps?saddr=${encodeURIComponent(route.originQuery)}&daddr=${DEST_QUERY}&output=embed&hl=es`;
            return (
              <button
                type="button"
                data-route-btn
                data-map-src={routeEmbedUrl}
                data-map-label={`Mostrando ruta en auto: Desde ${route.name} hasta Cabañas Pinamar (${route.distance})`}
                class="location-view-btn text-left p-5 rounded-2xl bg-[#FAF6F0] hover:bg-[#FFF5DF] border border-[#0A2246]/10 transition-all duration-200 flex flex-col justify-between group cursor-pointer"
              >
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-xs uppercase tracking-widest text-[#E86F2C] font-bold">
                      {route.name}
                    </span>
                    <span class="text-[11px] font-bold text-[#0A2246]/70 bg-white rounded-full px-2.5 py-0.5 border border-[#0A2246]/10">
                      {route.time}
                    </span>
                  </div>
                  <p class="font-serif text-2xl sm:text-3xl font-bold text-[#0A2246] mb-2">
                    {route.distance}
                  </p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0A2246] group-hover:text-[#E86F2C] uppercase tracking-wider mt-1">
                  <span>Trazar ruta en mapa</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- Barra de Navegación GPS Directa -->
      <div class="p-6 sm:p-8 bg-[#FAF6F0] flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="text-center lg:text-left">
          <p class="text-xs uppercase tracking-widest font-bold text-[#0A2246] mb-1">
            ¿Ya vienes en camino desde tu celular o auto?
          </p>
          <p class="text-sm text-[#0A2246]/75">
            Abre las coordenadas exactas del portón principal y estacionamiento privado en tu app de navegación favorita.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto shrink-0">
          <a
            href={GOOGLE_MAPS_DIR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 min-h-[48px] rounded-full bg-gradient-to-r from-[#E86F2C] to-[#F59B00] text-white font-bold text-xs uppercase tracking-widest px-6 py-3.5 transition-all duration-200 shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Cómo llegar en Google Maps</span>
          </a>

          <a
            href={WAZE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 min-h-[48px] rounded-full bg-[#0A2246] hover:bg-[#0A2246]/90 text-white font-bold text-xs uppercase tracking-widest px-6 py-3.5 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#F9C600] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
            <span>Abrir en Waze</span>
          </a>

          <a
            href={FULL_STREET_VIEW_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 min-h-[48px] rounded-full bg-white hover:bg-[#0A2246] hover:text-white text-[#0A2246] border border-[#0A2246]/20 font-bold text-xs uppercase tracking-widest px-5 py-3.5 transition-all duration-200"
          >
            <span>Abrir 360°</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" x2="21" y1="14" y2="3"></line>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const iframe = document.getElementById('pinamar-map-iframe') as HTMLIFrameElement | null;
  const label = document.getElementById('location-active-label');
  const buttons = document.querySelectorAll('.location-view-btn');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const nextSrc = btn.getAttribute('data-map-src');
      const nextLabel = btn.getAttribute('data-map-label');
      if (iframe && nextSrc && iframe.src !== nextSrc) {
        iframe.src = nextSrc;
      }
      if (label && nextLabel) {
        label.textContent = nextLabel;
      }

      buttons.forEach((other) => {
        const isRouteCard = other.hasAttribute('data-route-btn');
        if (other === btn) {
          if (isRouteCard) {
            other.classList.add('ring-2', 'ring-[#E86F2C]', 'bg-[#FFF5DF]');
          } else {
            other.classList.remove('bg-white', 'text-[#0A2246]');
            other.classList.add('bg-[#0A2246]', 'text-white');
          }
        } else {
          if (isRouteCard) {
            other.classList.remove('ring-2', 'ring-[#E86F2C]', 'bg-[#FFF5DF]');
          } else {
            other.classList.remove('bg-[#0A2246]', 'text-white');
            other.classList.add('bg-white', 'text-[#0A2246]');
          }
        }
      });
    });
  });
</script>
