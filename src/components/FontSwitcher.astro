---
const fuentes = [
  { id: 'actual', nombre: 'Source Serif 4', nota: 'La actual', family: '"Source Serif 4 Variable", Georgia, serif', wght: 470, track: '-0.01em' },
  { id: 'cormorant', nombre: 'Cormorant Garamond', nota: 'Fina y elegante', family: '"Cormorant Garamond", Georgia, serif', wght: 500, track: '0' },
  { id: 'playfair', nombre: 'Playfair Display', nota: 'Clásica, de alto contraste', family: '"Playfair Display", Georgia, serif', wght: 500, track: '-0.01em' },
  { id: 'caslon', nombre: 'Libre Caslon Display', nota: 'Editorial y sobria', family: '"Libre Caslon Display", Georgia, serif', wght: 400, track: '0' },
  { id: 'gilda', nombre: 'Gilda Display', nota: 'Suave, de hotel boutique', family: '"Gilda Display", Georgia, serif', wght: 400, track: '0' },
  { id: 'fraunces', nombre: 'Fraunces', nota: 'Cálida y redondeada', family: '"Fraunces", Georgia, serif', wght: 400, track: '-0.01em' },
  { id: 'bodoni', nombre: 'Bodoni Moda', nota: 'Lujo minimalista', family: '"Bodoni Moda", Georgia, serif', wght: 500, track: '0' },
  { id: 'instrument', nombre: 'Instrument Serif', nota: 'Moderna y tranquila', family: '"Instrument Serif", Georgia, serif', wght: 400, track: '0' },
];
const googleFonts =
  'https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500&family=Cormorant+Garamond:wght@500&family=Fraunces:opsz,wght@9..144,400&family=Gilda+Display&family=Instrument+Serif&family=Libre+Caslon+Display&family=Playfair+Display:wght@500&display=swap';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={googleFonts} />

<div
  data-fuentes={JSON.stringify(fuentes)}
  class="fixed z-[60] left-1/2 -translate-x-1/2 bottom-20 sm:bottom-6 w-[min(92vw,30rem)] rounded-full bg-ink/95 text-bone shadow-xl backdrop-blur flex items-center gap-1 p-1.5"
  role="group"
  aria-label="Probar tipografías de títulos y logotipo"
>
  <button type="button" data-prev class="w-11 h-11 shrink-0 grid place-items-center rounded-full hover:bg-bone/15" aria-label="Tipografía anterior">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6l-6 6 6 6" /></svg>
  </button>
  <div class="flex-1 min-w-0 text-center leading-tight" aria-live="polite">
    <p data-nombre class="text-[1.375rem] truncate">Source Serif 4</p>
    <p class="text-[12px] text-bone/70 tabular-nums"><span data-n>1</span> de {fuentes.length} · <span data-nota>La actual</span></p>
  </div>
  <button type="button" data-next class="w-11 h-11 shrink-0 grid place-items-center rounded-full hover:bg-bone/15" aria-label="Tipografía siguiente">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6l6 6-6 6" /></svg>
  </button>
</div>

<style is:global>
  html[data-fuente] .font-display {
    font-family: var(--fd) !important;
    font-weight: var(--fw) !important;
    letter-spacing: var(--ft) !important;
  }
</style>

<script>
  type Fuente = { id: string; nombre: string; nota: string; family: string; wght: number; track: string };
  const box = document.querySelector<HTMLElement>('[data-fuentes]');
  if (box) {
    const lista: Fuente[] = JSON.parse(box.dataset.fuentes || '[]');
    const nombre = box.querySelector<HTMLElement>('[data-nombre]')!;
    const nota = box.querySelector<HTMLElement>('[data-nota]')!;
    const n = box.querySelector<HTMLElement>('[data-n]')!;
    const root = document.documentElement;
    const desdeUrl = new URLSearchParams(location.search).get('fuente');
    let i = Math.max(0, lista.findIndex((f) => f.id === desdeUrl));

    const aplicar = () => {
      const f = lista[i];
      root.dataset.fuente = f.id;
      root.style.setProperty('--fd', f.family);
      root.style.setProperty('--fw', String(f.wght));
      root.style.setProperty('--ft', f.track);
      nombre.textContent = f.nombre;
      nombre.style.fontFamily = f.family;
      nombre.style.fontWeight = String(f.wght);
      nota.textContent = f.nota;
      n.textContent = String(i + 1);
      const url = new URL(location.href);
      url.searchParams.set('fuente', f.id);
      history.replaceState(null, '', url);
    };

    box.querySelector('[data-prev]')!.addEventListener('click', () => {
      i = (i - 1 + lista.length) % lista.length;
      aplicar();
    });
    box.querySelector('[data-next]')!.addEventListener('click', () => {
      i = (i + 1) % lista.length;
      aplicar();
    });
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('input, select, textarea, dialog')) return;
      if (e.key === 'ArrowLeft') box.querySelector<HTMLButtonElement>('[data-prev]')!.click();
      if (e.key === 'ArrowRight') box.querySelector<HTMLButtonElement>('[data-next]')!.click();
    });
    aplicar();
  }
</script>
