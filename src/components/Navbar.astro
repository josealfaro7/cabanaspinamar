---
---

<header class="sticky top-0 z-50 px-4 sm:px-8 pt-3 pb-2">
  <nav
    class="max-w-7xl mx-auto bg-white/90 backdrop-blur-xl border border-[#0A2246]/10 rounded-full px-5 sm:px-8 h-20 shadow-[0_12px_32px_-12px_rgba(10,34,70,0.12)] flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- Logotipo + Nombre (Sin subtítulo secundario) -->
    <a href="#" class="flex items-center focus:outline-none min-h-[44px] group">
      <img
        src="/logocabanas.png"
        alt="Cabañas Pinamar"
        class="h-11 sm:h-12 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <div class="ml-3">
        <span
          id="navbar-brand-text"
          class="block font-serif text-xl sm:text-2xl font-bold text-[#0A2246] tracking-tight leading-none"
        >
          Cabañas Pinamar
        </span>
      </div>
    </a>

    <!-- Navegación y Botón Pill -->
    <div class="flex items-center gap-5 sm:gap-8">
      <a
        href="#cabanas"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-[#0A2246]/80 hover:text-[#E86F2C] transition-colors duration-200"
      >
        Cabañas
      </a>
      <a
        href="#como-reservar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-[#0A2246]/80 hover:text-[#E86F2C] transition-colors duration-200"
      >
        Cómo Reservar
      </a>
      <a
        href="#como-llegar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-[#0A2246]/80 hover:text-[#E86F2C] transition-colors duration-200"
      >
        Cómo Llegar
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center min-h-[42px] rounded-full bg-[#0A2246] text-white hover:bg-[#E86F2C] px-6 py-2.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-in-out shadow-sm"
      >
        Contacto
      </a>
    </div>
  </nav>
</header>
