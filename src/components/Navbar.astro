---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 h-24 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- A la izquierda: Logotipo + Nombre -->
    <a href="#" class="flex items-center focus:outline-none">
      <img src="/logocabanas.png" alt="Logo" class="h-12 w-auto" />
      <span class="font-serif text-2xl font-bold text-primary ml-3">Cabañas Pinamar</span>
    </a>

    <!-- A la derecha: Botón de "Contacto" minimalista (sin fondo, solo contorno y texto) -->
    <div>
      <a
        href="#contacto"
        class="inline-block border border-primary text-primary px-6 py-2.5 text-xs uppercase tracking-widest font-bold rounded-none hover:bg-primary hover:text-white transition-all duration-300 ease-in-out"
      >
        Contacto
      </a>
    </div>
  </nav>
</header>
