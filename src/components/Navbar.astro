---
---

<header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-md border-b border-primary/5">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 h-24 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- Logotipo + Nombre en fuente Lora -->
    <a href="#" class="flex items-center focus:outline-none min-h-[44px]">
      <img src="/logocabanas.png" alt="Cabañas Pinamar" class="h-12 w-auto" />
      <span
        id="navbar-brand-text"
        style="font-family: 'Lora', Georgia, serif;"
        class="font-serif text-xl sm:text-2xl font-bold text-primary tracking-tight ml-3.5"
      >
        Cabañas Pinamar
      </span>
    </a>

    <!-- Navegación y Contacto con Tap Targets >= 44px -->
    <div class="flex items-center gap-6 sm:gap-8">
      <a
        href="#cabanas"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-primary/75 hover:text-primary transition-colors duration-200"
      >
        Tu Refugio
      </a>
      <a
        href="#como-reservar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-primary/75 hover:text-primary transition-colors duration-200"
      >
        Cómo Reservar
      </a>
      <a
        href="#como-llegar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-primary/75 hover:text-primary transition-colors duration-200"
      >
        Cómo Llegar
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center min-h-[44px] border border-primary/30 text-primary px-6 py-2.5 text-xs uppercase tracking-widest font-bold rounded-none hover:bg-primary hover:text-white transition-all duration-200 ease-out hover:scale-[1.02] active:scale-[0.98]"
      >
        Contacto
      </a>
    </div>
  </nav>
</header>
