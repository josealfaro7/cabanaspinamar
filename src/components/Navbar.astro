---
---

<header class="sticky top-0 z-50 bg-pinamar-ice/95 backdrop-blur-md border-b-2 border-dotted border-pinamar-navy/25">
  <!-- Franja Superior Retro-Sunset de 5 Tonos del Logo -->
  <div class="grid grid-cols-5 h-1.5 w-full">
    <div class="bg-sunset-1"></div>
    <div class="bg-sunset-2"></div>
    <div class="bg-sunset-3"></div>
    <div class="bg-sunset-4"></div>
    <div class="bg-sunset-5"></div>
  </div>

  <nav
    class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 h-22 py-4 flex items-center justify-between"
    aria-label="Navegación principal"
  >
    <!-- Logotipo + Nombre en Playfair Display y pinamar-navy -->
    <a href="#" class="flex items-center min-h-[44px] group">
      <img
        src="/logocabanas.webp"
        width="56"
        height="56"
        alt="Cabañas Pinamar"
        class="h-12 sm:h-14 w-auto transition-transform duration-300 group-hover:scale-105"
      />
      <div class="ml-3.5">
        <span
          id="navbar-brand-text"
          class="block font-serif text-xl sm:text-2xl font-bold text-pinamar-navy tracking-tight leading-none"
        >
          Cabañas Pinamar
        </span>
      </div>
    </a>

    <!-- Navegación y Botón Secundario Outline (#0A2246) -->
    <div class="flex items-center gap-6 sm:gap-8">
      <a
        href="#cabanas"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-pinamar-navy/80 hover:text-action transition-colors duration-200"
      >
        Cabañas
      </a>
      <a
        href="#como-reservar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-pinamar-navy/80 hover:text-action transition-colors duration-200"
      >
        Cómo reservar
      </a>
      <a
        href="#como-llegar"
        class="hidden md:inline-flex items-center min-h-[44px] text-xs uppercase tracking-widest font-bold text-pinamar-navy/80 hover:text-action transition-colors duration-200"
      >
        Cómo llegar
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center min-h-[44px] border border-pinamar-navy text-pinamar-navy hover:bg-pinamar-navy hover:text-white px-6 py-2.5 text-xs uppercase tracking-widest font-bold transition-all duration-300 ease-in-out"
      >
        Contacto
      </a>
    </div>
  </nav>
</header>
