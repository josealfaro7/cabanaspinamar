---
import { asset } from '../data/site';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cabañas Pinamar · La Serena, a pasos de la playa de Peñuelas',
  description = 'Cabañas familiares en La Serena desde hace más de 25 años. A 5 minutos a pie de la playa de Peñuelas, con recepción 24 horas y desayuno incluido.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F2EB" />
    <link rel="icon" type="image/png" href={asset('/favicon.png')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      html {
        -webkit-text-size-adjust: 100%;
      }
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
      body {
        font-size: 1.0625rem;
        line-height: 1.65;
      }
      /* Peso de los títulos (Source Serif 4 variable, eje wght 200–900). */
      :root {
        --display-wght: 470;
      }
      .font-display {
        font-weight: var(--display-wght);
        font-optical-sizing: auto;
        letter-spacing: -0.01em;
      }
      :focus-visible {
        outline: 2px solid theme('colors.terracotta.DEFAULT');
        outline-offset: 3px;
      }
      ::selection {
        background: theme('colors.sand');
        color: theme('colors.ink');
      }
      [id] {
        scroll-margin-top: 5rem;
      }
    </style>
  </head>
  <body class="bg-bone text-ink font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-bone focus:px-4 focus:py-3"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
