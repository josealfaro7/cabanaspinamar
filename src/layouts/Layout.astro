---
import { asset } from '../data/site';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/600.css';
import '../styles/fonts.css';
import playfairUrl from '../assets/fonts/playfair-display-latin-wght-normal.woff2?url';
import logoFontUrl from '../assets/fonts/playfair-display-sc-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Cabañas en La Serena a pasos de la playa | Cabañas Pinamar',
  description = 'Alojamiento familiar en La Serena: cabañas equipadas a 3 minutos a pie de la playa de Peñuelas, con desayuno incluido, recepción 24 horas y pet friendly.',
  noindex = false,
} = Astro.props;

const pathname = /\.[a-z0-9]+$/i.test(Astro.url.pathname) || Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(asset('/og-cabanas-pinamar.jpg'), Astro.site).href : asset('/og-cabanas-pinamar.jpg');
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F2EB" />
    <link rel="icon" type="image/png" href={asset('/favicon.png')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Cabañas Pinamar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cabaña blanca de techo de teja con terraza en Cabañas Pinamar, La Serena" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={asset('/sitemap.xml')} />
    <slot name="head" />
    <link rel="preload" href={playfairUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={logoFontUrl} as="font" type="font/woff2" crossorigin />
    <style is:global>
      html {
        -webkit-text-size-adjust: 100%;
      }
      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
      body {
        font-size: 1.0625rem;
        line-height: 1.65;
      }
      /* Títulos en Playfair Display; logotipo del header en Playfair Display SC. */
      :root {
        --display-wght: 500;
      }
      .font-logo {
        font-family: 'Playfair Display SC', Georgia, serif;
        font-weight: 700;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .font-display {
        font-weight: var(--display-wght);
        font-optical-sizing: auto;
        letter-spacing: -0.01em;
      }
      :focus-visible {
        outline: 2px solid theme('colors.terracotta.DEFAULT');
        outline-offset: 3px;
      }
      ::selection {
        background: theme('colors.sand');
        color: theme('colors.ink');
      }
      [id] {
        scroll-margin-top: 5rem;
      }
    </style>
  </head>
  <body class="bg-bone text-ink font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-bone focus:px-4 focus:py-3"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
