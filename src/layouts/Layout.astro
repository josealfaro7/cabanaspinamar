---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cabañas Pinamar | La Serena',
  description = 'Más de 25 años siendo parte de tus estadías. Tu lugar en La Serena a pasos del mar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logocabanas.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Fraunces (Organic Coastal Serif) + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      :root {
        --font-coastal-serif: 'Fraunces', Georgia, serif;
        --font-coastal-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      body {
        font-family: var(--font-coastal-sans);
      }
      .font-serif {
        font-family: var(--font-coastal-serif) !important;
      }
      .reveal-on-scroll {
        @apply opacity-0 translate-y-8 transition-all duration-700 ease-out;
        will-change: opacity, transform;
      }
      .reveal-on-scroll.is-visible {
        @apply opacity-100 translate-y-0;
      }
    </style>
  </head>
  <body class="bg-[#FAF6F0] text-[#0A2246] font-sans antialiased selection:bg-[#E86F2C] selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Luz Costera Orgánica Sutil en el Fondo -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-32 right-[-10%] w-[520px] h-[520px] rounded-full bg-[#FCE600]/20 blur-[130px]"></div>
      <div class="absolute top-[35%] left-[-12%] w-[480px] h-[480px] rounded-full bg-[#F59B00]/12 blur-[140px]"></div>
      <div class="absolute bottom-[10%] right-[5%] w-[500px] h-[500px] rounded-full bg-[#0A2246]/5 blur-[140px]"></div>
    </div>

    <slot />

    <script>
      const initScrollReveal = () => {
        const revealElements = document.querySelectorAll('.reveal-on-scroll');

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((el) => {
            el.classList.remove('opacity-0', 'translate-y-8');
            el.classList.add('is-visible', 'opacity-100', 'translate-y-0');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.remove('opacity-0', 'translate-y-8');
                target.classList.add('is-visible', 'opacity-100', 'translate-y-0');
                obs.unobserve(target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>
