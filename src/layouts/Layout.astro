---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cabañas Pinamar | La Serena',
  description = 'Más de 25 años siendo parte de tus estadías. Tu lugar en La Serena a pasos del mar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Playfair Display (Títulos Serif de alto contraste) + Plus Jakarta Sans (Cuerpo y UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Marca que hay JS: solo entonces se ocultan los bloques que aparecen al hacer scroll -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <style is:global>
      /* Foco visible por teclado en todo el sitio (WCAG 2.4.7) */
      :focus-visible {
        outline: 2px solid theme('colors.action');
        outline-offset: 3px;
      }

      /* Aparición al hacer scroll: sin JS el contenido queda visible */
      .js .reveal-on-scroll {
        transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .js .reveal-on-scroll:not(.is-visible) {
        opacity: 0;
        transform: translateY(2rem);
      }

      @media (prefers-reduced-motion: reduce) {
        .js .reveal-on-scroll {
          transition: opacity 300ms ease-out;
        }
        .js .reveal-on-scroll:not(.is-visible) {
          transform: none;
        }
        [class*='hover:-translate-y']:hover {
          transform: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-cream text-pinamar-navy font-sans antialiased selection:bg-logo-yellow/40 selection:text-pinamar-navy min-h-screen flex flex-col">
    <slot />

    <!-- Script Global de Scroll Reveal con IntersectionObserver -->
    <script>
      const initScrollReveal = () => {
        const revealElements = document.querySelectorAll('.reveal-on-scroll');

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((el) => {
            el.classList.add('is-visible');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.add('is-visible');
                obs.unobserve(target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>
