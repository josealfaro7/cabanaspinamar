---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cabañas Pinamar | La Serena',
  description = 'Más de 25 años siendo parte de tus estadías. Tu lugar en La Serena a pasos del mar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logocabanas.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Playfair Display (Títulos Serif de alto contraste) + Plus Jakarta Sans (Cuerpo y UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Cormorant+Garamond:wght@600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Libre+Baskerville:wght@700&family=Lora:wght@600;700&family=Marcellus&family=Merriweather:wght@700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Tenor+Sans&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      .reveal-on-scroll {
        @apply opacity-0 translate-y-8 transition-all duration-700 ease-out;
        will-change: opacity, transform;
      }
      .reveal-on-scroll.is-visible {
        @apply opacity-100 translate-y-0;
      }
    </style>
  </head>
  <body class="bg-pinamar-ice text-pinamar-navy font-sans antialiased selection:bg-sunset-3 selection:text-pinamar-navy min-h-screen flex flex-col">
    <slot />

    <!-- Script Global de Scroll Reveal con IntersectionObserver -->
    <script>
      const initScrollReveal = () => {
        const revealElements = document.querySelectorAll('.reveal-on-scroll');

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((el) => {
            el.classList.remove('opacity-0', 'translate-y-8');
            el.classList.add('is-visible', 'opacity-100', 'translate-y-0');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.remove('opacity-0', 'translate-y-8');
                target.classList.add('is-visible', 'opacity-100', 'translate-y-0');
                obs.unobserve(target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>
